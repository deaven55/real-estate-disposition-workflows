        "jsCode": "const b=$json.body??$json; const portfolioId=String(b.portfolioId??'default').trim(); const period=String(b.period??'all_time').trim(); const budget=n=>(Number.isFinite(Number(n))?Number(n):null); const availableBudget=budget(b.availableBudget); const asOfDate=b.asOfDate??new Date().toISOString(); return [{json:{...b,portfolioId,period,availableBudget,asOfDate,receivedAt:new Date().toISOString()}}];"
