{
  "name": "WF-390 — Post-Closing Deal / Assignment Reconciliation & Financial Settlement Controller",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "post-closing-settlement-reconciliation",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wf390-webhook",
      "name": "Post-Closing Settlement Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nconst required = ['assignmentId','dealId','settlementOutcome'];\nconst missing = required.filter(k => b[k] === undefined || b[k] === null || b[k] === '');\nif (missing.length) throw new Error('Missing required settlement fields: ' + missing.join(', '));\nconst allowed = new Set(['settled','partially_settled','pending','failed','reversed','cancelled']);\nconst settlementOutcome = String(b.settlementOutcome).toLowerCase();\nif (!allowed.has(settlementOutcome)) throw new Error('Unsupported settlement outcome: ' + settlementOutcome);\nconst idempotencyKey = String(b.idempotencyKey ?? ('wf390:settlement:' + String(b.assignmentId) + ':' + String(b.dealId) + ':' + settlementOutcome + ':' + String(b.eventId ?? 'default')));\nreturn [{ json: { ...b, assignmentId: String(b.assignmentId), dealId: String(b.dealId), settlementOutcome, idempotencyKey } }];"
      },
      "id": "wf390-normalize",
      "name": "Normalize Settlement Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://YOUR_INSULACRM_API/assignments/post-closing-context",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.INSULACRM_API_KEY}}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{$json.idempotencyKey}}:context"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "wf390-context",
      "name": "Fetch Post-Closing Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $json;\nconst assignment = ctx.assignment ?? ctx.data?.assignment ?? {};\nconst deal = ctx.deal ?? ctx.data?.deal ?? {};\nconst closing = ctx.closing ?? ctx.data?.closing ?? {};\nconst settlement = ctx.settlement ?? ctx.data?.settlement ?? {};\nconst dealState = String(deal.state ?? deal.status ?? '').toLowerCase();\nconst assignmentState = String(assignment.state ?? assignment.status ?? '').toLowerCase();\nconst closingStatus = String(closing.status ?? '').toLowerCase();\nconst issues = [];\nif (dealState !== 'closed' && closingStatus !== 'closed' && $json.settlementOutcome === 'settled') issues.push('closing_not_confirmed');\nif (['cancelled','disputed','dnc'].includes(dealState)) issues.push('deal_state_blocked:' + dealState);\nif (['cancelled','disputed'].includes(assignmentState) && !['cancelled','reversed'].includes($json.settlementOutcome)) issues.push('assignment_state_blocked:' + assignmentState);\nif ($json.settlementOutcome === 'settled') {\n  const required = ['settlementAmount','assignmentFee','settlementDate'];\n  for (const f of required) {\n    if (f === 'settlementDate' && !$json[f] && !settlement.settlementDate) issues.push('missing_settlement_date');\n    if (f !== 'settlementDate' && Number($json[f] ?? settlement[f] ?? 0) < 0) issues.push(f + '_invalid');\n  }\n}\nreturn [{ json: { ...$json, assignment, deal, closing, settlement, dealState, assignmentState, closingStatus, issues, valid: issues.length === 0 } }];"
      },
      "id": "wf390-validate",
      "name": "Validate Post-Closing Settlement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
