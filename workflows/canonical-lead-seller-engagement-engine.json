    {
      "parameters": {
        "jsCode": "const input=$('Normalize Lead Seller Event').first().json; const ctx=$json.context??$json; const text=String(input.responseText??input.message??'').toLowerCase(); const consent=ctx.consentStatus??input.consentStatus??'unknown'; const dnc=ctx.dnc===true||ctx.suppressed===true||/do not contact|unsubscribe|stop contacting/.test(text); const closed=['closed','cancelled','disputed'].includes(String(ctx.leadStatus??ctx.dealStatus??'').toLowerCase()); const duplicate=ctx.eventAlreadyProcessed===true; const priority=Math.max(0,Math.min(100,Number(ctx.priorityScore??ctx.aiPriorityScore??0))); const motivation=Math.max(0,Math.min(100,Number(ctx.motivationScore??0))); const distress=Math.max(0,Math.min(100,Number(ctx.distressScore??0))); const equity=Math.max(0,Math.min(100,Number(ctx.equityScore??0))); const urgency=Math.max(0,Math.min(100,Number(ctx.urgencyScore??ctx.timelineScore??0))); const baseScore=priority||Math.round((distress*0.25+equity*0.2+motivation*0.2+urgency*0.15+Number(ctx.contactabilityScore??50)*0.1+Number(ctx.sourceQualityScore??50)*0.1)); let tier=baseScore>=80?'A':baseScore>=60?'B':baseScore>=40?'C':'D'; let queue=tier==='A'?'hot':tier==='B'?'warm':tier==='C'?'standard':'nurture'; let route='outreach'; let nextAction='start_or_continue_seller_sequence'; const flags=[]; if(dnc){route='do_not_contact';nextAction='suppress_future_outreach';flags.push('dnc_or_suppressed');} else if(closed){route='closed_or_blocked';nextAction='no_further_outreach';flags.push('closed_or_blocked');} else if(duplicate){route='duplicate';nextAction='do_not_reprocess';flags.push('duplicate_event');} else if(consent==='denied'){route='consent_blocked';nextAction='do_not_contact';flags.push('consent_denied');} else if(consent==='unknown'&&['sms','email','voice','automated_outreach'].includes(String(input.channel??'').toLowerCase())){route='consent_review';nextAction='verify_consent_before_outreach';flags.push('consent_unknown');} else if(tier==='A'){route='priority_outreach';nextAction='immediate_seller_contact';} else if(tier==='B'){route='outreach';nextAction='seller_contact_within_4_hours';} else if(tier==='C'){route='outreach';nextAction='seller_contact_within_24_hours';} else {route='nurture';nextAction='seller_nurture_within_72_hours';} const idempotencyKey=input.idempotencyKey; return [{json:{...input,canonicalLeadSeller:{route,nextAction,priorityScore:baseScore,tier,queue,motivationScore:motivation,distressScore:distress,equityScore:equity,urgencyScore:urgency,consentStatus:consent,flags,requiresHumanReview:route==='consent_review'||tier==='A',confidenceScore:priority?85:65},idempotencyKey}}];"
      },
