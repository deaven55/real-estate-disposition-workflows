      "parameters": {
        "jsCode": "const input=$('Normalize Negotiation Cycle Request').first().json; const ctx=$json.context??$json; const n=v=>Number.isFinite(Number(v))?Number(v):0; const rounds=Array.isArray(ctx.rounds)?ctx.rounds:[]; const maxRounds=Math.max(1,n(ctx.maxRounds??5)); const currentRound=Math.max(0,n(ctx.currentRound??rounds.length)); const protectedMao=n(ctx.protectedMao); const currentOffer=n(ctx.currentOfferAmount); const latestCounter=n(ctx.latestCounterofferAmount??input.counterofferAmount); const openingOffer=n(ctx.openingOfferAmount); const risk=String(ctx.riskLevel??'medium').toLowerCase(); const motivation=n(ctx.sellerMotivationScore??ctx.motivationScore); const flags=[]; if(ctx.dnc===true||ctx.suppressed===true)flags.push('contact_blocked'); if(['closed','cancelled','disputed'].includes(String(ctx.dealState??ctx.status??'').toLowerCase()))flags.push('deal_not_negotiable'); if(latestCounter<=0)flags.push('invalid_counteroffer'); if(protectedMao>0&&latestCounter>protectedMao)flags.push('counteroffer_above_protected_mao'); const nextRound=currentRound+1; const remainingRounds=Math.max(0,maxRounds-nextRound); const gap=currentOffer>0?latestCounter-currentOffer:null; const gapPct=currentOffer>0?gap/currentOffer:null; let decision='human_review',nextAction='review_negotiation_cycle',concession=null; if(flags.length){decision='blocked';nextAction='stop_automated_negotiation';} else if(currentRound>=maxRounds){decision='walk_away_or_human_review';nextAction='max_negotiation_rounds_reached';} else if(protectedMao>0&&latestCounter>protectedMao){decision='walk_away_or_reengage';nextAction='decline_above_mao_and_reengage';} else if(protectedMao>0&&latestCounter<=protectedMao){const concessionBudget=Math.max(0,protectedMao-currentOffer);const suggestedStep=Math.max(1,concessionBudget/Math.max(2,remainingRounds+1));if(latestCounter<=currentOffer){decision='accept_or_contract';nextAction='accept_counteroffer_and_prepare_contract';}else if(motivation>=75&&risk!=='high'){concession=Math.min(latestCounter-1,Math.min(protectedMao,currentOffer+suggestedStep));concession=Math.max(concession,currentOffer);decision=concession>=latestCounter?'accept_or_contract':'controlled_concession';nextAction=concession>=latestCounter?'accept_counteroffer_and_prepare_contract':'send_concession_offer';}else{decision='human_review';nextAction='review_concession_before_sending';}}else{decision='human_review';nextAction='validate_protected_mao_before_concession';} const concessionFromPrevious=currentOffer>0&&concession!==null?concession-currentOffer:null; const concessionPercent=currentOffer>0&&concessionFromPrevious!==null?concessionFromPrevious/currentOffer:null; const idempotencyKey='wf439:'+input.leadId+':'+input.dealId+':'+input.negotiationId+':'+nextRound; return [{json:{...input,negotiationCycleDecision:{status:flags.length?'review_required':'evaluated',decision,nextAction,currentRound,nextRound,maxRounds,remainingRounds,openingOfferAmount:openingOffer,currentOfferAmount:currentOffer,latestCounterofferAmount:latestCounter,protectedMao,negotiationGap:gap,negotiationGapPercent:gapPct,suggestedConcessionAmount:concession,concessionFromPrevious,concessionPercent,flags,requiresHumanReview:decision==='human_review'||decision==='walk_away_or_human_review',confidenceScore:flags.length?20:(decision==='human_review'?60:93)},idempotencyKey}}];"
