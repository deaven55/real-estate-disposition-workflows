    {
      "parameters": {
        "jsCode": "const input=$('Normalize Title Results').first().json; const ctx=$json.context??$json; const flags=[]; const title=ctx.titleResults??ctx; const dealState=String(ctx.dealState??ctx.status??'').toLowerCase(); if(['closed','cancelled','disputed','dnc','suppressed'].includes(dealState)||ctx.dnc===true||ctx.suppressed===true)flags.push('deal_or_contact_blocked'); const searchComplete=title.searchCompleted===true||String(title.searchStatus??'').toLowerCase()==='completed'; if(!searchComplete)flags.push('title_search_incomplete'); const liens=Array.isArray(title.liens)?title.liens:[]; const judgments=Array.isArray(title.judgments)?title.judgments:[]; const encumbrances=Array.isArray(title.encumbrances)?title.encumbrances:[]; const taxIssues=Array.isArray(title.taxIssues)?title.taxIssues:[]; const unresolved=[...liens,...judgments,...encumbrances,...taxIssues].filter(x=>String(x.status??'open').toLowerCase()!=='resolved'); const openLiens=unresolved.filter(x=>['lien','tax_lien'].includes(String(x.type??'lien').toLowerCase())).length; const openJudgments=unresolved.filter(x=>String(x.type??'').toLowerCase()==='judgment').length; const openEncumbrances=unresolved.filter(x=>!['judgment','lien','tax_lien'].includes(String(x.type??'encumbrance').toLowerCase())).length; const openTaxIssues=unresolved.filter(x=>['tax','tax_lien','delinquent_tax'].includes(String(x.type??'tax').toLowerCase())).length; const totalExposure=unresolved.reduce((s,x)=>s+(Number(x.amount??x.exposure??0)||0),0); const titleClear=searchComplete&&unresolved.length===0; const riskScore=Math.min(100,(openLiens*20)+(openJudgments*25)+(openEncumbrances*15)+(openTaxIssues*20)+(totalExposure>0?Math.min(20,totalExposure/10000):0)); let riskLevel=titleClear?'low':riskScore>=70?'critical':riskScore>=40?'high':riskScore>=20?'medium':'low'; let decision='hold_for_title_resolution',nextAction='resolve_title_and_tax_issues',clearanceState='pending'; if(flags.includes('deal_or_contact_blocked')){decision='blocked';nextAction='stop_closing_flow';clearanceState='blocked';}else if(titleClear){decision='clear_for_closing';nextAction='advance_to_closing_date_and_final_settlement_coordination';clearanceState='cleared';}else if(!searchComplete){decision='await_title_results';nextAction='await_completed_title_search';clearanceState='pending';}else if(riskLevel==='critical'){decision='halt_and_escalate';nextAction='escalate_critical_title_risk';clearanceState='critical_hold';} const resolutionActions=unresolved.map(x=>({id:x.id??null,type:x.type??'unknown',amount:Number(x.amount??x.exposure??0)||0,action:x.requiredAction??'obtain_release_or_resolution_evidence'})); const idempotencyKey='wf444:'+input.leadId+':'+input.dealId+':'+input.titleOrderId+':'+input.resultEventId; return [{json:{...input,titleRiskClearanceDecision:{status:clearanceState,decision,nextAction,riskLevel,riskScore,searchCompleted:searchComplete,titleClear,openIssueCount:unresolved.length,openLiens,openJudgments,openEncumbrances,openTaxIssues,totalPotentialExposure:Math.round(totalExposure*100)/100,resolutionActions,flags,requiresHumanReview:!titleClear||riskLevel==='critical',confidenceScore:titleClear?98:searchComplete?80:35},idempotencyKey}}];"
      },
