    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nconst required = ['assignmentId','dealId','buyerId','sellerId','completionType'];\nconst missing = required.filter(k => b[k] === undefined || b[k] === null || b[k] === '');\nif (missing.length) throw new Error('Missing required transaction completion fields: ' + missing.join(', '));\nconst allowed = new Set(['transaction_completed','buyer_completion','seller_completion','funds_disbursed','documents_released','completion_failed','completion_cancelled']);\nconst completionType = String(b.completionType).toLowerCase();\nif (!allowed.has(completionType)) throw new Error('Unsupported completion type: ' + completionType);\nconst idempotencyKey = String(b.idempotencyKey ?? ('wf391:transaction-completion:' + String(b.assignmentId) + ':' + String(b.dealId) + ':' + completionType + ':' + String(b.eventId ?? 'default')));\nreturn [{ json: { ...b, assignmentId: String(b.assignmentId), dealId: String(b.dealId), buyerId: String(b.buyerId), sellerId: String(b.sellerId), completionType, idempotencyKey } }];"
      },
      "id": "wf391-normalize",
      "name": "Normalize Completion Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "https://YOUR_INSULACRM_API/assignments/post-closing-completion-context",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.INSULACRM_API_KEY}}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{$json.idempotencyKey}}:context"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "wf391-context",
      "name": "Fetch Transaction Completion Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $json;\nconst assignment = ctx.assignment ?? ctx.data?.assignment ?? {};\nconst deal = ctx.deal ?? ctx.data?.deal ?? {};\nconst buyer = ctx.buyer ?? ctx.data?.buyer ?? {};\nconst seller = ctx.seller ?? ctx.data?.seller ?? {};\nconst settlement = ctx.settlement ?? ctx.data?.settlement ?? {};\nconst blocked = new Set(['cancelled','disputed','dnc']);\nconst dealState = String(deal.state ?? deal.status ?? '').toLowerCase();\nconst assignmentState = String(assignment.state ?? assignment.status ?? '').toLowerCase();\nconst settlementStatus = String(settlement.status ?? '').toLowerCase();\nconst buyerActive = buyer.active === true || String(buyer.status ?? '').toLowerCase() === 'active';\nconst sellerValid = seller.id !== undefined && seller.id !== null;\nconst issues = [];\nif (!buyerActive) issues.push('buyer_not_active');\nif (!sellerValid) issues.push('seller_identity_not_confirmed');\nif (blocked.has(dealState)) issues.push('deal_state_blocked:' + dealState);\nif (blocked.has(assignmentState) && !['completion_cancelled','completion_failed'].includes($json.completionType)) issues.push('assignment_state_blocked:' + assignmentState);\nif (['transaction_completed','funds_disbursed'].includes($json.completionType) && !['settled','completed'].includes(settlementStatus)) issues.push('settlement_not_confirmed');\nconst valid = issues.length === 0;\nreturn [{ json: { ...$json, assignment, deal, buyer, seller, settlement, dealState, assignmentState, settlementStatus, issues, valid } }];"
      },
