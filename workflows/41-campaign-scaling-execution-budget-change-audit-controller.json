    },
    {
      "parameters": {
        "jsCode": "const input=$('Normalize Scaling Execution Request').first().json; const ctx=$json.context??$json; const approved=input.approved===true||ctx.approved===true; const action=input.action; const allowed=['scale','maintain_optimize','reduce_or_pause']; const current=Number(ctx.currentBudget??0); const requested=Number(input.requestedBudget||ctx.recommendedBudget||0); const max=Number(ctx.maxBudget??0); const min=Number(ctx.minBudget??0); const delta=requested-current; let status='blocked',reason=''; if(!approved) reason='explicit approval is required before budget execution'; else if(!allowed.includes(action)) reason='unsupported scaling action'; else if(requested<0) reason='budget cannot be negative'; else if(max>0&&requested>max) reason='requested budget exceeds configured maximum'; else if(requested<min) reason='requested budget is below configured minimum'; else if(!input.requestedBy) reason='requestedBy is required for auditability'; else status='approved_for_execution'; return [{json:{...input,context:ctx,executionDecision:{status,reason,action,currentBudget:current,requestedBudget:requested,budgetDelta:delta,approvalRequired:true,approvedBy:input.requestedBy,approvedAt:new Date().toISOString()}}}];"
      },
