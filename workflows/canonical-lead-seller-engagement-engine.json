        "jsCode": "const b=$json.body??$json; const eventType=String(b.eventType??b.type??'').trim().toLowerCase(); const leadId=String(b.leadId??'').trim(); const sellerId=String(b.sellerId??b.ownerId??'').trim(); const propertyId=String(b.propertyId??'').trim(); const portfolioId=String(b.portfolioId??'').trim(); const campaignId=String(b.campaignId??'').trim(); const source=String(b.source??b.leadSource??'').trim(); const idempotencyKey=String(b.idempotencyKey??('lead-seller:'+eventType+':'+leadId+':'+(b.eventId??campaignId))).trim(); return [{json:{...b,eventType,leadId,sellerId,propertyId,portfolioId,campaignId,source,idempotencyKey,receivedAt:new Date().toISOString()}}];"
      },
