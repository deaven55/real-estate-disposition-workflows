    {
      "parameters": {
        "jsCode": "const input=$('Normalize Request').first().json; const ctx=$json.context??$json; const vs=Array.isArray(ctx.variants)?ctx.variants:input.variants; const rate=(a,b)=>b>0?a/b:0; const variants=vs.map(v=>{const i=Number(v.impressions||0),vis=Number(v.visits||0),l=Number(v.leads||0),q=Number(v.qualifiedLeads||0),a=Number(v.appointments||0),c=Number(v.contracts||0),cl=Number(v.closedDeals||0),s=Number(v.spend||0),r=Number(v.revenue||0),p=Number(v.netProfit||0); return {...v,impressions:i,visits:vis,leads:l,qualifiedLeads:q,appointments:a,contracts:c,closedDeals:cl,spend:s,revenue:r,netProfit:p,visitRate:rate(vis,i),leadRate:rate(l,vis),qualificationRate:rate(q,l),appointmentRate:rate(a,q),contractRate:rate(c,l),closeRate:rate(cl,c),cpl:s>0?s/l:null,cpql:s>0?s/q:null,cpa:s>0?s/a:null,costPerContract:s>0?s/c:null,costPerClosedDeal:s>0?s/cl:null,roi:s>0?p/s:null,profitMultiple:s>0?p/s:null};}); return [{json:{...input,context:ctx,variants}}];"
      },
      "id": "w401e",
      "name": "Calculate Variant Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
