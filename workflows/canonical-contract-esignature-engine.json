    {
      "parameters": {
        "jsCode": "const input=$('Normalize Contract Event').first().json; const c=$json.context??$json; const status=String(c.dealStatus??c.contractStatus??'').toLowerCase(); const executed=String(c.executionStatus??'').toLowerCase()==='executed'||c.executed===true; const sellerSigned=c.sellerSigned===true||c.requiredSellerSignaturePresent===true; const buyerSigned=c.buyerSigned===true||c.requiredBuyerSignaturePresent===true; const identityVerified=c.sellerIdentityVerified===true&&c.propertyIdentityVerified===true; const economicsReady=c.purchasePrice>0&&((c.protectedMao??0)<=0||Number(c.purchasePrice)<=Number(c.protectedMao)); const titleConfirmed=c.titleCompanyConfirmed===true||c.titleCompanyId!=null; const requiredDocs=Array.isArray(c.requiredDocuments)?c.requiredDocuments:[]; const missingDocs=requiredDocs.filter(d=>d.required!==false&&!['complete','verified','signed'].includes(String(d.status??'').toLowerCase())).map(d=>d.id??d.name??'unknown'); const event=String(input.eventType).toLowerCase(); let decision='contract_readiness_pending'; let action='collect_missing_contract_requirements'; const flags=[]; if(['closed','cancelled','disputed'].includes(status)){decision='blocked';action='no_contract_action';flags.push('protected_deal_state');} else if(event==='dnc'){decision='blocked';action='suppress_contract_communications';flags.push('dnc');} else if(event.includes('esign')||event.includes('signature')||event==='provider_event'||event==='contract.signed'||event==='signed'||event==='executed'){ if(event==='completed'||event==='executed'||event==='signed'||event==='contract.signed'||executed){ if(sellerSigned&&buyerSigned&&identityVerified&&economicsReady){decision='executed';action='advance_to_title_closing';} else {decision='execution_review';action='reconcile_missing_execution_evidence';flags.push('execution_evidence_incomplete');}} else if(['declined','rejected','voided','cancelled','expired','failed'].includes(event)){decision='signature_failed';action='reissue_or_human_review';flags.push('signature_event_failed');} else {decision='signature_pending';action='await_required_signatures';}} else { if(!identityVerified)flags.push('identity_verification_missing'); if(!economicsReady)flags.push('economics_not_ready'); if(missingDocs.length)flags.push('documents_missing'); if(!titleConfirmed)flags.push('title_company_unconfirmed'); if(sellerSigned){} if(identityVerified&&economicsReady&&missingDocs.length===0&&titleConfirmed){decision='ready_for_signature';action='generate_and_route_signature_package';} else {decision='contract_readiness_pending';action='collect_missing_contract_requirements';}} const readinessScore=Math.max(0,Math.min(100,Math.round((identityVerified?25:0)+(economicsReady?25:0)+(missingDocs.length===0?20:0)+(titleConfirmed?10:0)+(sellerSigned?10:0)+(buyerSigned?10:0)))); return [{json:{...input,canonicalContract:{decision,action,readinessScore,executed, sellerSigned,buyerSigned,identityVerified,economicsReady,titleConfirmed,missingDocuments:missingDocs,flags,requiresHumanReview:['execution_review','signature_failed'].includes(decision),nextEvent:decision==='executed'?'title_closing':decision==='ready_for_signature'?'signature_request':'none',confidenceScore:executed?90:readinessScore},idempotencyKey}}];"
      },
