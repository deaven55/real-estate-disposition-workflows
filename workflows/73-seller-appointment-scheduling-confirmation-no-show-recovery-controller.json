    {
      "parameters": {
        "jsCode": "const input=$('Normalize Appointment Event').first().json; const ctx=$json.context??$json; const blocked=['dnc','suppressed','closed','cancelled']; const event=input.eventType; const leadStatus=String(ctx.leadStatus??ctx.status??'').toLowerCase(); const flags=[]; if(blocked.includes(leadStatus)||ctx.dnc===true||ctx.suppressed===true)flags.push('contact_blocked'); const validEvents=['scheduled','confirmed','rescheduled','cancelled','completed','no_show','late_cancel','seller_cancelled','buyer_or_agent_cancelled']; if(!validEvents.includes(event))flags.push('unknown_event'); const appointment=ctx.appointment??{}; const scheduledAt=appointment.scheduledAt??input.scheduledAt??null; const now=Date.now(); const scheduledTime=scheduledAt?new Date(scheduledAt).getTime():null; const minutesUntil=scheduledTime!==null?(scheduledTime-now)/60000:null; let state='manual_review',nextAction='review_appointment_event',recovery=null; if(flags.length){state='blocked';nextAction='stop_appointment_follow_up';} else if(event==='scheduled'){state='scheduled';nextAction='send_confirmation_and_reminder';} else if(event==='confirmed'){state='confirmed';nextAction='send_final_reminder_and_prepare_call';} else if(event==='rescheduled'){state='rescheduled';nextAction='send_updated_confirmation';} else if(event==='completed'){state='completed';nextAction='route_to_seller_qualification_or_offer';} else if(event==='cancelled'||event==='seller_cancelled'||event==='buyer_or_agent_cancelled'){state='cancelled';nextAction='offer_reschedule_and_resume_follow_up';recovery={type:'reschedule_recovery',priority:'high'};} else if(event==='no_show'||event==='late_cancel'){state='no_show_recovery';nextAction='trigger_no_show_recovery_sequence';recovery={type:'no_show_recovery',priority:'high',attempts:3,cadenceMinutes:[30,240,1440]};} const idempotencyKey='wf435:'+input.leadId+':'+input.appointmentId+':'+event; return [{json:{...input,appointmentDecision:{status:flags.length?'blocked':'evaluated',state,nextAction,scheduledAt,minutesUntil,confirmationRequired:['scheduled','rescheduled'].includes(event),reminderRequired:['scheduled','confirmed','rescheduled'].includes(event),recovery,flags,requiresHumanReview:state==='manual_review',confidenceScore:flags.length?10:(state==='manual_review'?55:94)},idempotencyKey}}];"
      },
