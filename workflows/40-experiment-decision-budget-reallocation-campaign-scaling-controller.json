      "id": "w402d",
      "name": "Fetch Experiment Budget Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        660,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const input=$('Normalize Scaling Request').first().json; const ctx=$json.context??$json; const variants=Array.isArray(ctx.variants)?ctx.variants:input.variants; const eligible=variants.filter(v=>Number(v.impressions||0)>=100&&Number(v.leads||0)>=10); const scored=eligible.map(v=>{const roi=Number(v.roi??0),close=Number(v.closeRate??0),profit=Number(v.netProfit??0),spend=Number(v.spend??0); const efficiency=spend>0?profit/spend:0; const score=Math.max(0,Math.min(100,(roi*40)+(close*30)+(Math.min(efficiency,5)/5*20)+10)); return {...v,scalingScore:score};}).sort((a,b)=>b.scalingScore-a.scalingScore); const leader=scored[0]; let action='hold',reason='insufficient evidence for scaling'; let recommendedBudget=Number(input.budget||ctx.currentBudget||0); if(scored.length>=2&&leader){if(leader.scalingScore>=75&&Number(leader.roi||0)>0){action='scale'; recommendedBudget=Math.min(Number(ctx.maxBudget||recommendedBudget*1.5||0),Math.max(Number(ctx.minBudget||0),recommendedBudget*1.25||0)); reason='winner has sufficient sample and strong efficiency';} else if(leader.scalingScore>=55){action='maintain_optimize'; reason='leader is promising but not strong enough for aggressive scaling';} else {action='reduce_or_pause'; recommendedBudget=Number(ctx.minBudget||0); reason='experiment evidence does not justify continued spend at current level';}} return [{json:{...input,context:ctx,eligibleVariants:scored,scalingDecision:{action,reason,leaderVariantId:leader?.variantId??leader?.id??leader?.name??null,currentBudget:recommendedBudget===0?Number(input.budget||0):Number(input.budget||ctx.currentBudget||0),recommendedBudget,decisionScore:leader?.scalingScore??0,decidedAt:new Date().toISOString()}}}];"
      },
