      "parameters": {
        "jsCode": "const b=$json.body??$json; const eventType=String(b.eventType??b.type??'').trim().toLowerCase(); const ids={leadId:String(b.leadId??b.entity?.leadId??'').trim(),sellerId:String(b.sellerId??b.entity?.sellerId??'').trim(),propertyId:String(b.propertyId??b.entity?.propertyId??'').trim(),dealId:String(b.dealId??b.entity?.dealId??'').trim(),buyerId:String(b.buyerId??b.entity?.buyerId??'').trim(),portfolioId:String(b.portfolioId??b.entity?.portfolioId??'').trim()}; const idempotencyKey=String(b.idempotencyKey??('platform:'+eventType+':'+ids.leadId+':'+ids.dealId+':'+(b.eventId??''))).trim(); const family=eventType.split('.')[0]||eventType; const map={lead:'lead-seller',seller:'lead-seller',outreach:'lead-seller',appointment:'lead-seller',property:'underwriting-risk',comp:'underwriting-risk',arv:'underwriting-risk',repair:'underwriting-risk',underwriting:'underwriting-risk',risk:'underwriting-risk',mao:'underwriting-risk',offer:'negotiation-offer',counteroffer:'negotiation-offer',negotiation:'negotiation-offer',contract:'contract-esignature',esignature:'contract-esignature',signature:'contract-esignature',execution:'contract-esignature',buyer:'buyer-disposition',assignment:'buyer-disposition',disposition:'buyer-disposition',pof:'buyer-disposition',title:'title-closing',lien:'title-closing',tax:'title-closing',closing:'title-closing',settlement:'title-closing',funds:'title-closing',profit:'financials-analytics',payout:'financials-analytics',finance:'financials-analytics',analytics:'financials-analytics',kpi:'financials-analytics',forecast:'financials-analytics',financials:'financials-analytics'}; const engine=String(b.engine??map[family]??'').trim(); const correlationId=String(b.metadata?.correlationId??b.correlationId??('corr:'+idempotencyKey)).trim(); return [{json:{...b,...ids,eventType,idempotencyKey,engine,correlationId,receivedAt:new Date().toISOString(),canonicalEnvelope:{schemaVersion:'1.0',eventId:String(b.eventId??''),eventType,occurredAt:String(b.occurredAt??new Date().toISOString()),source:String(b.source??'n8n'),idempotencyKey,entity:ids,payload:b.payload??{},metadata:{...(b.metadata??{}),correlationId}}}}];"
      },
