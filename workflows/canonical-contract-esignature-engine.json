        "jsCode": "const b=$json.body??$json; const eventType=String(b.eventType??b.type??'contract_readiness').trim().toLowerCase(); const leadId=String(b.leadId??'').trim(); const sellerId=String(b.sellerId??'').trim(); const buyerId=String(b.buyerId??'').trim(); const propertyId=String(b.propertyId??'').trim(); const dealId=String(b.dealId??'').trim(); const contractId=String(b.contractId??'').trim(); const assignmentId=String(b.assignmentId??'').trim(); const portfolioId=String(b.portfolioId??'').trim(); const idempotencyKey=String(b.idempotencyKey??('contract:'+eventType+':'+leadId+':'+dealId+':'+contractId+':'+(b.providerEventId??b.eventId??''))).trim(); return [{json:{...b,eventType,leadId,sellerId,buyerId,propertyId,dealId,contractId,assignmentId,portfolioId,idempotencyKey,receivedAt:new Date().toISOString()}}];"
      },
