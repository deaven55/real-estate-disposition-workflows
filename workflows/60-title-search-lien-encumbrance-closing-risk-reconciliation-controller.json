    {
      "parameters": {
        "jsCode": "const input=$('Normalize Title Risk Request').first().json; const ctx=$json.context??$json; const title=ctx.title??{}; const liens=Array.isArray(ctx.liens)?ctx.liens:[]; const enc=Array.isArray(ctx.encumbrances)?ctx.encumbrances:[]; const judgments=Array.isArray(ctx.judgments)?ctx.judgments:[]; const taxes=Array.isArray(ctx.taxLiens)?ctx.taxLiens:[]; const flags=[]; const status=String(title.status??'').toLowerCase(); if(['failed','rejected','cancelled'].includes(status))flags.push('title_search_failed'); if(title.clearToClose===false)flags.push('title_not_clear_to_close'); if(title.searchCompleted!==true)flags.push('title_search_incomplete'); if(liens.some(x=>x.valid===true||x.open===true))flags.push('open_liens'); if(enc.some(x=>x.valid===true||x.active===true))flags.push('active_encumbrances'); if(judgments.some(x=>x.valid===true||x.open===true))flags.push('outstanding_judgments'); if(taxes.some(x=>x.valid===true||x.open===true))flags.push('tax_lien_or_tax_issue'); const materialLiens=liens.filter(x=>Number(x.amount??0)>0); const materialEnc=enc.filter(x=>Number(x.amount??0)>0); const totalLienExposure=materialLiens.reduce((s,x)=>s+Number(x.amount||0),0)+materialEnc.reduce((s,x)=>s+Number(x.amount||0),0); const severity=flags.includes('title_search_failed')?'critical':(flags.includes('open_liens')||flags.includes('outstanding_judgments')||flags.includes('tax_lien_or_tax_issue')?'high':flags.includes('active_encumbrances')||flags.includes('title_not_clear_to_close')?'medium':'low'); const decision=severity==='critical'?'halt_and_research':severity==='high'?'hold_closing_and_resolve_title':severity==='medium'?'proceed_with_title_resolution':'title_clear_for_closing'; const idempotencyKey='wf422:'+input.leadId+':'+input.propertyId+':'+input.dealId+':'+input.assignmentId; return [{json:{...input,titleRisk:{status:severity==='low'?'clear':'exception',severity,decision,flags,counts:{liens:liens.length,encumbrances:enc.length,judgments:judgments.length,taxIssues:taxes.length},financialExposure:{totalLienAndEncumbranceAmount:Math.round(totalLienExposure*100)/100},requiredActions:decision==='title_clear_for_closing'?['confirm_final_title_clearance','release_to_closing']:['obtain_lien_payoff_or_release','resolve_judgments_and_encumbrances','confirm_tax_status','obtain_updated_title_commitment'],confidenceScore:title.searchCompleted===true?90:55},idempotencyKey}}];"
      },
