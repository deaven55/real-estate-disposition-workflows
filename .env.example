# Canonical platform deployment environment
# Copy to your deployment environment; do not commit real secrets.

N8N_BASE_URL=https://YOUR_N8N_HOST
INSULACRM_API_BASE_URL=https://YOUR_INSULACRM_API_HOST

# n8n webhook paths
CANONICAL_PLATFORM_WEBHOOK=/webhook/canonical-platform-integration-hardening
CANONICAL_LIFECYCLE_HANDOFF_WEBHOOK=/webhook/canonical-lifecycle-handoff
PLATFORM_EVENT_ROUTER_WEBHOOK=/webhook/platform-event-router

# Configure the actual InsulaCRM API credential in n8n Credentials.
# Never place bearer tokens, API keys, or passwords in this file.
