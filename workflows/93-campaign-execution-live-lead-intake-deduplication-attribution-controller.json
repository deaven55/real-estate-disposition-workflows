    {
      "parameters": {
        "jsCode": "const input=$('Normalize Live Lead Intake').first().json; const ctx=$json.context??$json; const existing=ctx.existingLead??ctx.duplicateLead??null; const duplicate=ctx.isDuplicate===true||!!existing; const suppressed=ctx.dnc===true||ctx.suppressed===true||String(ctx.contactStatus??'').toLowerCase()==='dnc'; const consent=String(ctx.consentStatus??'unknown').toLowerCase(); const attributionValid=!!input.source&&!!input.channel; const attribution={source:input.source,channel:input.channel,campaignId:input.campaignId||null,medium:input.medium??null,term:input.term??null,content:input.content??null,landingPage:input.landingPage??null}; const flags=[]; if(duplicate)flags.push('duplicate_or_existing_lead'); if(suppressed)flags.push('dnc_or_suppressed'); if(!attributionValid)flags.push('missing_attribution'); if(['denied','revoked'].includes(consent))flags.push('consent_denied_or_revoked'); let route='new_lead'; if(suppressed)route='blocked_suppressed'; else if(duplicate)route='existing_lead_merge_or_update'; else if(['denied','revoked'].includes(consent))route='consent_blocked'; const intakeAllowed=!suppressed&&!['denied','revoked'].includes(consent); const idempotencyKey='wf455:'+input.portfolioId+':'+input.leadId+':'+input.source+':'+(input.campaignId||'none'); return [{json:{...input,liveLeadIntake:{route,intakeAllowed,duplicate,existingLeadId:existing?.id??existing?.leadId??null,suppressed,consentStatus:consent,attribution,flags,requiresHumanReview:route==='existing_lead_merge_or_update'||flags.includes('missing_attribution'),confidenceScore:flags.length?70:92},idempotencyKey}}];"
      },
