      "parameters": {
        "jsCode": "const input=$('Normalize E-Signature Event').first().json; const ctx=$json.context??$json; const required=Array.isArray(ctx.requiredSigners)?ctx.requiredSigners:[]; const signatures=Array.isArray(ctx.signatures)?ctx.signatures:[]; const requiredIds=required.map(s=>String(s.id??s.signerId??s.role??s).toLowerCase()); const signedIds=signatures.filter(s=>String(s.status??'').toLowerCase()==='signed').map(s=>String(s.signerId??s.id??s.role??'').toLowerCase()); const allRequiredSigned=requiredIds.length>0?requiredIds.every(id=>signedIds.includes(id)):ctx.allRequiredSignaturesComplete===true; const terminal=['completed','signed','executed','completed_successfully'].includes(input.eventType); const failed=['declined','rejected','voided','cancelled','expired','failed'].includes(input.eventType); const blockedStates=['closed','cancelled','disputed','dnc','suppressed']; const dealState=String(ctx.dealState??ctx.status??'').toLowerCase(); const flags=[]; if(blockedStates.includes(dealState)||ctx.dnc===true||ctx.suppressed===true)flags.push('deal_or_contact_blocked'); if(failed)flags.push('esignature_terminal_failure'); if(terminal&&!allRequiredSigned)flags.push('required_signatures_incomplete'); if(!ctx.documentId&&terminal)flags.push('executed_document_missing'); let decision='pending_signature',nextAction='await_remaining_signatures',executionState='signature_pending'; if(flags.includes('deal_or_contact_blocked')){decision='blocked';nextAction='stop_contract_execution_flow';executionState='blocked';}else if(failed){decision='signature_failed';nextAction='route_signature_recovery_or_reissue';executionState='signature_failed';}else if(terminal&&allRequiredSigned&&ctx.documentId){decision='executed';nextAction='advance_to_title_and_closing_coordination';executionState='executed';}else if(terminal&&!allRequiredSigned){decision='signature_incomplete';nextAction='identify_and_route_missing_signers';executionState='signature_pending';} const idempotencyKey='wf442:'+input.leadId+':'+input.dealId+':'+input.contractId+':'+input.eventId; return [{json:{...input,contractExecutionReconciliation:{status:decision==='executed'?'executed':decision==='blocked'?'blocked':'reconciled',decision,nextAction,executionState,allRequiredSignaturesComplete:allRequiredSigned,requiredSignerCount:requiredIds.length,signedSignerCount:signedIds.length,documentId:ctx.documentId??null,provider:ctx.provider??input.provider??null,providerEventId:input.eventId,flags,requiresHumanReview:['blocked','signature_failed','signature_incomplete'].includes(decision),confidenceScore:decision==='executed'?98:decision==='pending_signature'?90:35},idempotencyKey}}];"
