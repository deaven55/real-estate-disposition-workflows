      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input=$input.first().json.body||$input.first().json; const required=['dealId','address','city','state']; const missing=required.filter(k=>!input[k]); let state=String(input.state||'').trim().toUpperCase(); const aliases={'NORTH CAROLINA':'NC','SOUTH CAROLINA':'SC','NEW YORK':'NY','NEW JERSEY':'NJ','NEW MEXICO':'NM','NEW HAMPSHIRE':'NH','WEST VIRGINIA':'WV','WASHINGTON':'WA','DISTRICT OF COLUMBIA':'DC'}; state=aliases[state]||state; return [{json:{valid:missing.length===0&&/^[A-Z]{2}$/.test(state),errors:missing.length?missing:(/^[A-Z]{2}$/.test(state)?[]:['state']),dealId:input.dealId,address:String(input.address||'').trim(),city:String(input.city||'').trim(),state,zip:String(input.zip||'').trim(),county:String(input.county||'').trim(),property_type:input.property_type??null,square_footage:input.square_footage??null,bedrooms:input.bedrooms??null,bathrooms:input.bathrooms??null,year_built:input.year_built??null,acreage:input.acreage??null,maxComps:input.maxComps??8,activity:input.activity||'acquisition',pipeline_version:'v1'}}];"
      }
    },
    {
      "id": "ifvalid",
      "name": "IF Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "strict",
            "leftValue": ""
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "bad",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        260
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({success:false,errors:$json.errors}) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
