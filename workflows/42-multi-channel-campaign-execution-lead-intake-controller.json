      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        660,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const input=$('Normalize Multi-Channel Lead').first().json; const ctx=$json.context??$json; const existing=ctx.existingLead??null; const duplicate=Boolean(existing?.leadId||ctx.duplicate===true); const consent=ctx.consentStatus??input.consentStatus??'unknown'; const suppressed=Boolean(ctx.suppressed||input.suppressed); const route=suppressed?'blocked':duplicate?'existing_lead':(consent==='granted'||consent==='unknown'?'new_lead':'consent_review'); return [{json:{...input,context:ctx,intakeDecision:{status:route,duplicate,existingLeadId:existing?.leadId??null,consentStatus:consent,suppressed,attribution:{source:input.source,channel:input.channel,campaignId:input.campaignId},idempotencyKey:'wf404:'+input.leadId+':'+input.source+':'+(input.campaignId||'none')}}}];"
      },
      "id": "w404e",
      "name": "Determine Intake & Attribution Route",
