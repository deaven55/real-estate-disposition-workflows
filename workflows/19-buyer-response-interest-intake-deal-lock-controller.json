{
  "name": "WholeStack WF-381: Buyer Response Interest Intake & Deal-Lock Controller",
  "nodes": [
    {
      "id": "webhook",
      "name": "Buyer Response Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "wholestack-buyer-response-interest",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "normalize",
      "name": "Normalize Buyer Interest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ],
      "parameters": {
        "jsCode": "var b=$input.first().json.body||$input.first().json;\nvar raw=String(b.intent||b.responseType||b.status||'').toLowerCase().trim();\nvar intent=['interested','offer','lock_request','schedule_call','declined','dnc','expired'].indexOf(raw)>=0?raw:'other';\nvar amount=Number(b.offerAmount||b.price||0);\nreturn [{json:{...b,intent:intent,offerAmount:amount,receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "fetch",
      "name": "Fetch Buyer Deal Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INSULACRM_API/buyers/response-context",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({dealId:$json.dealId,assignmentId:$json.assignmentId,buyerId:$json.buyerId,intent:$json.intent,offerAmount:$json.offerAmount}) }}"
      }
    },
    {
      "id": "guard",
      "name": "Enforce Buyer Response Guardrails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        930,
        300
      ],
      "parameters": {
        "jsCode": "var d=$input.first().json;\nvar state=String(d.dealStatus||'').toLowerCase();\nvar protectedState=['closed','cancelled','disputed','contracted'].indexOf(state)>=0;\nvar buyerBlocked=d.buyerActive===false||d.buyerSuppressed===true||d.dnc===true;\nvar hasIds=!!d.dealId&&!!d.assignmentId&&!!d.buyerId;\nvar offerValid=d.intent!=='offer'||(Number(d.offerAmount)>0&&(!d.protectedMAO||Number(d.offerAmount)<=Number(d.protectedMAO)));\nvar blocked=!hasIds||protectedState||buyerBlocked||!offerValid;\nvar reason=!hasIds?'missing_identity':protectedState?'deal_protected':buyerBlocked?'buyer_blocked':!offerValid?'offer_outside_guardrails':null;\nreturn [{json:{...d,blocked:blocked,blockedReason:reason}}];"
      }
    },
    {
      "id": "route",
      "name": "Route Buyer Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1160,
        300
      ],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.intent }}",
        "rules": [
          {
            "operation": "equal",
            "value2": "interested"
          },
          {
            "operation": "equal",
            "value2": "offer"
          },
          {
            "operation": "equal",
            "value2": "lock_request"
          },
          {
            "operation": "equal",
            "value2": "schedule_call"
          },
          {
            "operation": "equal",
            "value2": "declined"
          },
          {
            "operation": "equal",
            "value2": "dnc"
          },
          {
            "operation": "equal",
            "value2": "expired"
          }
        ]
      }
    },
    {
      "id": "lock",
      "name": "Persist Buyer Interest / Lock Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1390,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INSULACRM_API/buyers/interest-lock",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({dealId:$json.dealId,assignmentId:$json.assignmentId,buyerId:$json.buyerId,intent:$json.intent,offerAmount:$json.offerAmount||null,idempotencyKey:'wf381:interest:'+String($json.dealId)+':'+String($json.assignmentId)+':'+String($json.buyerId)+':'+String($json.intent)}) }}"
      }
    },
    {
      "id": "decline",
      "name": "Persist Buyer Decline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1390,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INSULACRM_API/buyers/decline",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({dealId:$json.dealId,assignmentId:$json.assignmentId,buyerId:$json.buyerId,intent:$json.intent,idempotencyKey:'wf381:decline:'+String($json.dealId)+':'+String($json.assignmentId)+':'+String($json.buyerId)}) }}"
      }
    },
    {
      "id": "dnc",
      "name": "Persist Buyer DNC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1390,
        520
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INSULACRM_API/buyers/dnc",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({dealId:$json.dealId,assignmentId:$json.assignmentId,buyerId:$json.buyerId,intent:'dnc',idempotencyKey:'wf381:dnc:'+String($json.buyerId)}) }}"
      }
    },
    {
      "id": "other",
      "name": "Persist Buyer Other Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1390,
        640
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INSULACRM_API/buyers/response",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({dealId:$json.dealId,assignmentId:$json.assignmentId,buyerId:$json.buyerId,intent:$json.intent,offerAmount:$json.offerAmount||null,idempotencyKey:'wf381:response:'+String($json.dealId)+':'+String($json.buyerId)+':'+String($json.intent)}) }}"
      }
    },
    {
      "id": "respond",
      "name": "Respond Buyer Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1710,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseBody": "={{ JSON.stringify({success:true,workflow:'WF-381',intent:$json.intent,dealId:$json.dealId,assignmentId:$json.assignmentId,buyerId:$json.buyerId,blocked:$json.blocked||false}) }}"
      }
    },
    {
      "id": "blocked",
      "name": "Respond Buyer Response Blocked",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1390,
        800
      ],
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseBody": "={{ JSON.stringify({success:true,workflow:'WF-381',processed:false,reason:$json.blockedReason||'buyer_response_blocked',dealId:$json.dealId||null,buyerId:$json.buyerId||null}) }}"
      }
    }
  ],
