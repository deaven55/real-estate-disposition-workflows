        "jsCode": "const b = $json.body ?? $json;\nconst required = ['assignmentId','dealId','buyerId','sellerId'];\nconst missing = required.filter(k => b[k] === undefined || b[k] === null || b[k] === '');\nif (missing.length) throw new Error('Missing required closing coordination fields: ' + missing.join(', '));\nconst assignmentId = String(b.assignmentId);\nconst dealId = String(b.dealId);\nconst buyerId = String(b.buyerId);\nconst sellerId = String(b.sellerId);\nconst idempotencyKey = String(b.idempotencyKey ?? ('wf387:closing-coordination:' + assignmentId + ':' + dealId + ':' + buyerId + ':' + sellerId));\nreturn [{ json: { ...b, assignmentId, dealId, buyerId, sellerId, idempotencyKey } }];"
      },
