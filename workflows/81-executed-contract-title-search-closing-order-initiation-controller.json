    {
      "parameters": {
        "jsCode": "const input=$('Normalize Executed Contract Request').first().json; const ctx=$json.context??$json; const flags=[]; const executionState=String(ctx.executionState??ctx.contractState??'').toLowerCase(); const blocked=['closed','cancelled','disputed','dnc','suppressed']; const dealState=String(ctx.dealState??ctx.status??'').toLowerCase(); if(blocked.includes(dealState)||ctx.dnc===true||ctx.suppressed===true)flags.push('deal_or_contact_blocked'); if(!['executed','fully_executed','contract_executed'].includes(executionState))flags.push('contract_not_verified_executed'); const executedDocumentId=String(ctx.executedDocumentId??ctx.documentId??'').trim(); if(!executedDocumentId)flags.push('executed_document_missing'); const titleCompany={id:ctx.titleCompanyId??null,name:ctx.titleCompanyName??null,contact:ctx.titleCompanyContact??null}; const titleCompanyReady=Boolean(titleCompany.id||titleCompany.name); if(!titleCompanyReady)flags.push('title_company_missing'); const propertyId=String(ctx.propertyId??'').trim(); const propertyAddress=String(ctx.propertyAddress??'').trim(); if(!propertyId)flags.push('property_id_missing'); if(!propertyAddress)flags.push('property_address_missing'); const purchasePrice=Number(ctx.purchasePrice??0); if(!(purchasePrice>0))flags.push('purchase_price_missing'); const assignmentId=String(ctx.assignmentId??'').trim(); if(!assignmentId)flags.push('assignment_id_missing'); const ready=flags.length===0; const decision=ready?'initiate_title_and_closing_order':'hold_for_prerequisite_resolution'; const nextAction=ready?'open_title_search_and_closing_order':'resolve_execution_or_closing_prerequisites'; const packagePayload={executionId:input.executionId,contractId:input.contractId,executedDocumentId:executedDocumentId||null,assignmentId:assignmentId||null,property:{propertyId:propertyId||null,address:propertyAddress||null},titleCompany,financials:{purchasePrice:purchasePrice||null},requestedServices:['title_search','lien_and_encumbrance_search','tax_status_review','closing_order_initiation']}; const idempotencyKey='wf443:'+input.leadId+':'+input.dealId+':'+input.contractId+':'+input.executionId; return [{json:{...input,titleClosingInitiationDecision:{status:ready?'ready':'blocked',decision,nextAction,executionState,packagePayload,flags,requiresHumanReview:!ready,confidenceScore:ready?97:20},idempotencyKey}}];"
      },
