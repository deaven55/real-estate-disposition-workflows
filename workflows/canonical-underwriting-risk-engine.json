    {
      "parameters": {
        "jsCode": "const input=$('Normalize Underwriting Event').first().json; const c=$json.context??$json; const n=x=>Number.isFinite(Number(x))?Number(x):0; const arv=n(c.arv??input.arv); const repairs=n(c.repairs??c.repairEstimate??input.repairs); const repairCont=n(c.repairContingencyPct??input.repairContingencyPct??10); const closingPct=n(c.closingCostPct??input.closingCostPct??3); const holding=n(c.holdingCosts??input.holdingCosts); const wholesale=n(c.wholesaleCosts??input.wholesaleCosts); const purchase=n(c.purchasePrice??input.purchasePrice); const investorMarginPct=n(c.investorMarginPct??input.investorMarginPct??15); const conventionalRule=n(c.conventionalMaoPct??input.conventionalMaoPct??70); const contingency=repairs*(repairCont/100); const totalCosts=repairs+contingency+(arv*(closingPct/100))+holding+wholesale; const conventionalMao=Math.max(0,arv*(conventionalRule/100)-repairs-contingency-holding-wholesale); const investorMarginMao=Math.max(0,arv-totalCosts-(arv*(investorMarginPct/100))); const protectedMao=Math.min(conventionalMao,investorMarginMao); const recommendedMao=Math.min(protectedMao,n(c.recommendedMao??protectedMao)); const projectedProfit=arv-purchase-totalCosts; const spreadToMao=recommendedMao-purchase; const marginPct=arv>0?(projectedProfit/arv)*100:0; const completeness=[arv>0,repairs>=0,purchase>=0].filter(Boolean).length/3; const flags=[]; if(arv<=0)flags.push('missing_arv'); if(repairs<0)flags.push('invalid_repairs'); if(purchase<0)flags.push('invalid_purchase_price'); if(purchase>protectedMao&&protectedMao>0)flags.push('purchase_above_protected_mao'); if(projectedProfit<0)flags.push('negative_projected_profit'); if(marginPct<10&&arv>0)flags.push('thin_projected_margin'); if(repairs/arv>0.35&&arv>0)flags.push('high_repair_burden'); const riskScore=Math.min(100,Math.round((flags.includes('negative_projected_profit')?40:0)+(flags.includes('purchase_above_protected_mao')?25:0)+(flags.includes('high_repair_burden')?15:0)+(flags.includes('thin_projected_margin')?15:0)+(completeness<1?20:0))); const riskLevel=riskScore>=60?'critical':riskScore>=35?'high':riskScore>=15?'medium':'low'; const decision=flags.includes('missing_arv')||flags.includes('invalid_repairs')||flags.includes('invalid_purchase_price')?'human_review':flags.includes('negative_projected_profit')||flags.includes('purchase_above_protected_mao')?'reprice_or_exit':riskLevel==='high'||riskLevel==='critical'?'proceed_with_caution':purchase>0&&purchase<=recommendedMao?'approved_for_offer':'prepare_underwriting'; return [{json:{...input,canonicalUnderwriting:{arv,repairs,repairContingencyPct:repairCont,repairContingency:contingency,closingCostPct:closingPct,holdingCosts:holding,wholesaleCosts:wholesale,totalCosts,conventionalMao,investorMarginMao,protectedMao,recommendedMao,purchasePrice:purchase,spreadToMao,projectedInvestorProfit:projectedProfit,projectedMarginPct:marginPct,dataCompleteness:completeness,riskScore,riskLevel,flags,decision,confidenceScore:Math.round(completeness*70+(flags.length===0?30:10))},idempotencyKey}}];"
      },
