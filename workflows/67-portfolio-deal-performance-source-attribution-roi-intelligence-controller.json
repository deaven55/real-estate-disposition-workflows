    {
      "parameters": {
        "jsCode": "const input=$('Normalize Portfolio ROI Request').first().json; const ctx=$json.context??$json; const deals=Array.isArray(ctx.closedDeals)?ctx.closedDeals:[]; const n=v=>Number.isFinite(Number(v))?Number(v):0; const groups=new Map(); for(const d of deals){if(String(d.status??d.lifecycleState??'').toLowerCase()!=='closed')continue; const source=String(d.source??d.leadSource??'unknown').trim()||'unknown'; const channel=String(d.channel??d.marketingChannel??'unknown').trim()||'unknown'; const campaign=String(d.campaignId??d.campaign??'unattributed').trim()||'unattributed'; const key=source+'|'+channel+'|'+campaign; if(!groups.has(key))groups.set(key,{source,channel,campaign,closedDeals:0,grossRevenue:0,netProfit:0,spend:0,investment:0}); const g=groups.get(key); g.closedDeals++; g.grossRevenue+=n(d.grossRevenue??d.financials?.grossRevenue); g.netProfit+=n(d.netProfit??d.financials?.netProfit); g.spend+=n(d.sourceSpend??d.spend??d.marketingSpend); g.investment+=n(d.totalInvestment??d.purchasePrice??d.financials?.purchasePrice);} const rows=[...groups.values()].map(g=>{const roiBase=g.investment+g.spend; return {...g,costPerClosedDeal:g.closedDeals?g.spend/g.closedDeals:null,profitPerClosedDeal:g.closedDeals?g.netProfit/g.closedDeals:null,roi:roiBase?g.netProfit/roiBase:null,profitMultiple:g.spend?g.netProfit/g.spend:null};}).sort((a,b)=>(b.netProfit-a.netProfit)); const total=rows.reduce((a,g)=>({closedDeals:a.closedDeals+g.closedDeals,grossRevenue:a.grossRevenue+g.grossRevenue,netProfit:a.netProfit+g.netProfit,spend:a.spend+g.spend}),{closedDeals:0,grossRevenue:0,netProfit:0,spend:0}); const top=rows.slice(0,5); const bottom=[...rows].sort((a,b)=>a.netProfit-b.netProfit).slice(0,5); const actions=rows.map(g=>{if(g.roi!==null&&g.roi>=1&&g.netProfit>0)return{...g,recommendation:'scale_or_expand'};if(g.roi!==null&&g.roi<0)return{...g,recommendation:'reduce_or_pause'};if(g.closedDeals<2)return{...g,recommendation:'collect_more_data'};return{...g,recommendation:'maintain_and_optimize'};}); const idempotencyKey='wf429:'+input.portfolioId+':'+input.period+':'+input.asOfDate; return [{json:{...input,portfolioROIIntelligence:{status:rows.length?'aggregated':'blocked',summary:total,sourceChannelCampaignPerformance:rows,topPerformers:top,underperformers:bottom,recommendations:actions,flags:rows.length?[]:['no_attributed_closed_deals'],nextAction:rows.length?'apply_source_and_campaign_optimization':'reconcile_closed_deal_attribution',confidenceScore:rows.length?94:30},idempotencyKey}}];"
      },
