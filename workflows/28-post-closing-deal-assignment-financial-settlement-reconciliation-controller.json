    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, workflow: 'WF-390', status: ($json.settlementOutcome === 'settled' ? 'closed_settled' : ($json.settlementOutcome === 'partially_settled' ? 'closed_partial_settlement' : ($json.settlementOutcome === 'reversed' ? 'settlement_reversed' : ($json.settlementOutcome === 'failed' ? 'settlement_failed' : ($json.settlementOutcome === 'cancelled' ? 'settlement_cancelled' : 'settlement_pending'))))), assignmentId: $json.assignmentId, dealId: $json.dealId, settlementOutcome: $json.settlementOutcome, message: 'Post-closing settlement and deal lifecycle reconciliation persisted.' } }}",
        "options": {
