      ],
      "parameters": {
        "jsCode": "const base=$('Preserve Ranking Context').first().json; return [{json:{success:true,pipeline:'acquisition-to-underwriting',pipeline_version:base.pipeline_version,dealId:base.dealId,jurisdiction:{state:base.state,county:base.county},property:{address:base.address,city:base.city,zip:base.zip},stages:{property_intelligence:base.property_intelligence_result,comps_arv:base.comps_arv_result,offer_decision:base.offer_decision_result,ranking:base.ranking_result,compliance:$json},next_action:$json?.result?.automation_allowed===true?'Eligible for downstream workflow after required human controls':'Review required before automated seller/buyer activity'}}];"
      }
    },
