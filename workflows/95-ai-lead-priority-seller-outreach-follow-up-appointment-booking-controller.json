        "jsCode": "const b=$json.body??$json; const leadId=String(b.leadId??'').trim(); const portfolioId=String(b.portfolioId??'').trim(); const priorityScore=Number(b.priorityScore??0); const tier=String(b.tier??'').trim().toUpperCase(); const nextAction=String(b.recommendedNextAction??'').trim(); const channel=String(b.channel??'sms').trim().toLowerCase(); const sequenceId=String(b.sequenceId??('priority-'+tier)).trim(); const appointmentRequested=b.appointmentRequested===true||String(b.appointmentRequested??'').toLowerCase()==='true'; return [{json:{...b,leadId,portfolioId,priorityScore,tier,nextAction,channel,sequenceId,appointmentRequested,receivedAt:new Date().toISOString()}}];"
      },
