      "parameters": {
        "jsCode": "const input=$('Normalize Post-Closing Financial Request').first().json; const ctx=$json.context??$json; const flags=[]; const state=String(ctx.dealState??ctx.lifecycleState??ctx.status??'').toLowerCase(); if(!['closed','settled','completed'].includes(state))flags.push('deal_not_closed_or_settled'); if(ctx.fundsConfirmed!==true)flags.push('funds_not_confirmed'); if(ctx.settlementReconciled!==true&&ctx.settlementState!=='reconciled')flags.push('settlement_not_reconciled'); const n=v=>Number.isFinite(Number(v))?Number(v):0; const grossRevenue=n(ctx.grossRevenue??ctx.assignmentFee??ctx.actualAssignmentFee); const purchasePrice=n(ctx.purchasePrice); const closingCosts=n(ctx.closingCosts); const otherCosts=n(ctx.otherCosts); const totalCosts=Math.round((purchasePrice+closingCosts+otherCosts)*100)/100; const netProfit=Math.round((grossRevenue-totalCosts)*100)/100; const ownerSharePercent=n(ctx.ownerSharePercent??100); const reservePercent=n(ctx.reservePercent??0); const ownerShareAmount=Math.round((netProfit*Math.max(0,Math.min(ownerSharePercent,100))/100)*100)/100; const reserveAmount=Math.round((netProfit*Math.max(0,Math.min(reservePercent,100))/100)*100)/100; const expectedOwnerDistribution=Math.round((ownerShareAmount-reserveAmount)*100)/100; const recordedOwnerDistribution=n(ctx.recordedOwnerDistribution??ctx.ownerDistribution); const distributionDelta=Math.round((recordedOwnerDistribution-expectedOwnerDistribution)*100)/100; const tol=Math.max(0.01,n(ctx.reconciliationTolerance??0.01)); const distributionReconciled=Math.abs(distributionDelta)<=tol; if(!distributionReconciled)flags.push('owner_distribution_mismatch'); if(ownerSharePercent<0||ownerSharePercent>100)flags.push('invalid_owner_share_percent'); if(reservePercent<0||reservePercent>100)flags.push('invalid_reserve_percent'); if(netProfit<0)flags.push('negative_net_profit'); let decision='hold_for_financial_reconciliation',nextAction='resolve_financial_or_distribution_exceptions',status='exception'; if(flags.includes('deal_not_closed_or_settled')||flags.includes('funds_not_confirmed')){decision='blocked_pending_closing_evidence';nextAction='complete_closing_and_funds_confirmation';status='blocked';}else if(flags.includes('invalid_owner_share_percent')||flags.includes('invalid_reserve_percent')){decision='human_review_required';nextAction='correct_owner_distribution_rules';status='review';}else if(distributionReconciled&&!flags.includes('settlement_not_reconciled')){decision='post_closing_financials_reconciled';nextAction='archive_closed_deal_and_update_portfolio_kpis';status='reconciled';} const idempotencyKey='wf448:'+input.leadId+':'+input.dealId+':'+input.settlementId+':'+input.closingEventId; return [{json:{...input,postClosingFinancialReconciliation:{status,decision,nextAction,grossRevenue,purchasePrice,closingCosts,otherCosts,totalCosts,netProfit,ownerSharePercent,reservePercent,ownerShareAmount,reserveAmount,expectedOwnerDistribution,recordedOwnerDistribution,distributionDelta,reconciliationTolerance:tol,distributionReconciled,flags,requiresHumanReview:['exception','review'].includes(status),confidenceScore:status==='reconciled'?99:status==='blocked'?20:55},idempotencyKey}}];"
