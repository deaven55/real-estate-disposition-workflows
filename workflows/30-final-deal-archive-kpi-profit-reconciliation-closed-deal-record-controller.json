    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nconst required = ['assignmentId','dealId'];\nconst missing = required.filter(k => b[k] === undefined || b[k] === null || b[k] === '');\nif (missing.length) throw new Error('Missing required archive fields: ' + missing.join(', '));\nconst idempotencyKey = String(b.idempotencyKey ?? ('wf392:archive:' + String(b.assignmentId) + ':' + String(b.dealId) + ':' + String(b.eventId ?? 'default')));\nreturn [{ json: { ...b, assignmentId: String(b.assignmentId), dealId: String(b.dealId), idempotencyKey } }];"
      },
      "id": "wf392-normalize",
      "name": "Normalize Final Archive Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "https://YOUR_INSULACRM_API/deals/final-archive-context",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.INSULACRM_API_KEY}}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{$json.idempotencyKey}}:context"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "wf392-context",
      "name": "Fetch Final Deal Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $json;\nconst assignment = ctx.assignment ?? ctx.data?.assignment ?? {};\nconst deal = ctx.deal ?? ctx.data?.deal ?? {};\nconst settlement = ctx.settlement ?? ctx.data?.settlement ?? {};\nconst completion = ctx.completion ?? ctx.data?.completion ?? {};\nconst dealState = String(deal.state ?? deal.status ?? '').toLowerCase();\nconst settlementStatus = String(settlement.status ?? '').toLowerCase();\nconst completionStatus = String(completion.status ?? '').toLowerCase();\nconst issues = [];\nif (!['closed','closed_settled'].includes(dealState)) issues.push('deal_not_closed:' + dealState);\nif (!['settled','completed'].includes(settlementStatus)) issues.push('settlement_not_confirmed:' + settlementStatus);\nif (!['completed','closed'].includes(completionStatus)) issues.push('transaction_completion_not_confirmed:' + completionStatus);\nconst purchasePrice = Number(assignment.purchasePrice ?? deal.purchasePrice ?? 0);\nconst assignmentFee = Number(assignment.assignmentFee ?? deal.assignmentFee ?? 0);\nconst closingCosts = Number(assignment.closingCosts ?? deal.closingCosts ?? 0);\nconst otherCosts = Number(assignment.otherCosts ?? deal.otherCosts ?? 0);\nconst grossRevenue = Number(assignment.grossRevenue ?? deal.grossRevenue ?? assignmentFee);\nconst netProfit = Number(assignment.netProfit ?? deal.netProfit ?? (grossRevenue - closingCosts - otherCosts));\nif (purchasePrice < 0 || assignmentFee < 0 || closingCosts < 0 || otherCosts < 0) issues.push('financial_values_invalid');\nconst archiveEligible = issues.length === 0;\nreturn [{ json: { ...$json, assignment, deal, settlement, completion, dealState, settlementStatus, completionStatus, purchasePrice, assignmentFee, closingCosts, otherCosts, grossRevenue, netProfit, issues, archiveEligible } }];"
      },
