      "parameters": {
        "jsCode": "const r = $json;\nconst assignment = r.assignment ?? r.data?.assignment ?? {};\nconst deal = r.deal ?? r.data?.deal ?? {};\nconst buyer = r.buyer ?? r.data?.buyer ?? {};\nconst seller = r.seller ?? r.data?.seller ?? {};\nconst approval = r.approval ?? r.data?.approval ?? {};\nconst contract = r.contract ?? r.data?.contract ?? {};\nconst signatures = r.signatures ?? r.data?.signatures ?? {};\nconst blockedStates = new Set(['closed','cancelled','disputed','dnc']);\nconst dealState = String(deal.state ?? deal.status ?? '').toLowerCase();\nconst assignmentState = String(assignment.state ?? assignment.status ?? '').toLowerCase();\nconst approvalStatus = String(approval.status ?? approval.decision ?? '').toLowerCase();\nconst buyerActive = buyer.active === true || String(buyer.status ?? '').toLowerCase() === 'active';\nconst sellerValid = seller.id !== undefined && seller.id !== null;\nconst contractReady = contract.ready === true || contract.contractReady === true;\nconst buyerSigned = signatures.buyerSigned === true || contract.buyerSigned === true;\nconst sellerSigned = signatures.sellerSigned === true || contract.sellerSigned === true;\nconst purchasePrice = Number(assignment.purchasePrice ?? deal.purchasePrice ?? 0);\nconst assignmentFee = Number(assignment.assignmentFee ?? deal.assignmentFee ?? 0);\nconst issues = [];\nif (approvalStatus !== 'approved') issues.push('assignment_approval_not_confirmed');\nif (!contractReady) issues.push('contract_not_ready');\nif (!buyerSigned) issues.push('buyer_signature_not_confirmed');\nif (!sellerSigned) issues.push('seller_signature_not_confirmed');\nif (!buyerActive) issues.push('buyer_not_active');\nif (!sellerValid) issues.push('seller_identity_not_confirmed');\nif (!(purchasePrice > 0)) issues.push('purchase_price_invalid');\nif (!(assignmentFee >= 0)) issues.push('assignment_fee_invalid');\nif (blockedStates.has(dealState)) issues.push('deal_state_blocked:' + dealState);\nif (blockedStates.has(assignmentState)) issues.push('assignment_state_blocked:' + assignmentState);\nconst closingReady = issues.length === 0;\nreturn [{ json: { ...r, assignment, deal, buyer, seller, approval, contract, signatures, purchasePrice, assignmentFee, closingReady, issues, dealState, assignmentState, approvalStatus } }];"
      },
