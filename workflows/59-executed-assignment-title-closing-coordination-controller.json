    {
      "parameters": {
        "jsCode": "const input=$('Normalize Closing Coordination Request').first().json; const ctx=$json.context??$json; const d=ctx.deal??{}; const title=ctx.title??{}; const closing=ctx.closing??{}; const doc=ctx.document??{}; const flags=[]; const executed=ctx.contractExecutionStatus==='executed'||doc.executionStatus==='executed'||d.assignmentContractExecuted===true; if(!executed)flags.push('assignment_contract_not_executed'); if(title.status&&['failed','rejected','cancelled'].includes(String(title.status).toLowerCase()))flags.push('title_process_blocked'); if(closing.status&&['failed','cancelled'].includes(String(closing.status).toLowerCase()))flags.push('closing_process_blocked'); if(title.clearToClose===false)flags.push('title_not_clear_to_close'); if(closing.ready===false)flags.push('closing_not_ready'); if(!ctx.titleCompanyId&&!title.companyId)flags.push('title_company_missing'); if(!ctx.closingContactId&&!closing.contactId)flags.push('closing_contact_missing'); const blocked=flags.includes('assignment_contract_not_executed')||flags.includes('title_process_blocked')||flags.includes('closing_process_blocked'); const coordinationStatus=blocked?'blocked':flags.length?'pending_requirements':'ready'; const nextAction=coordinationStatus==='ready'?'open_or_update_title_order_and_schedule_closing':coordinationStatus==='blocked'?'resolve_contract_title_or_closing_blocker':'collect_missing_title_closing_requirements'; const packageData={assignmentId:d.assignmentId??ctx.assignmentId??null,dealId:input.dealId,propertyId:input.propertyId,buyerId:input.buyerId,documentId:input.documentId,titleCompanyId:ctx.titleCompanyId??title.companyId??null,closingContactId:ctx.closingContactId??closing.contactId??null,propertyAddress:ctx.propertyAddress??ctx.property?.address??null,executedContractEvidence:{providerEventId:ctx.providerEventId??doc.providerEventId??null,documentHash:ctx.documentHash??doc.documentHash??null,executedAt:ctx.executedAt??doc.executedAt??null}}; const idempotencyKey='wf421:'+input.leadId+':'+input.propertyId+':'+input.dealId+':'+input.buyerId+':'+input.documentId; return [{json:{...input,titleClosingCoordination:{status:coordinationStatus,nextAction,flags,packageData,coordinationSteps:coordinationStatus==='ready'?['create_or_confirm_title_order','send_executed_assignment_package','confirm_title_opened','collect_closing_date','confirm_buyer_and_seller_contacts','track_clear_to_close']:['resolve_blockers','revalidate_execution_and_title_closing_readiness'],confidenceScore:coordinationStatus==='ready'?95:Math.max(0,65-flags.length*8)},idempotencyKey}}];"
      },
