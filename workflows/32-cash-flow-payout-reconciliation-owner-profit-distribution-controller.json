        "jsCode": "const b = $json.body ?? $json;\nconst required = ['dealId'];\nconst missing = required.filter(k => b[k] === undefined || b[k] === null || b[k] === '');\nif (missing.length) throw new Error('Missing required payout fields: ' + missing.join(', '));\nconst eventType = String(b.eventType ?? 'settlement_confirmed').toLowerCase();\nconst idempotencyKey = String(b.idempotencyKey ?? ('wf394:payout:' + String(b.dealId) + ':' + eventType + ':' + String(b.eventId ?? 'default')));\nreturn [{ json: { ...b, dealId: String(b.dealId), eventType, idempotencyKey } }];"
      },
