        "jsCode": "const input=$('Normalize Canonical Event Envelope').first().json; const r=$json.result??$json; const alreadyProcessed=r.alreadyProcessed===true||r.processed===true; const protectedState=['closed','cancelled','disputed'].includes(String(input.dealStatus??r.dealStatus??'').toLowerCase()); const allowed=['lead-seller','underwriting-risk','negotiation-offer','contract-esignature','buyer-disposition','title-closing','financials-analytics'].includes(input.engine); const action=alreadyProcessed?'replay_blocked':protectedState?'protected_state_blocked':allowed?'dispatch_engine':'invalid_engine'; return [{json:{...input,idempotencyCheck:r,canonicalIntegration:{alreadyProcessed,protectedState,allowed,action,dispatchAllowed:action==='dispatch_engine',route:'/canonical-'+input.engine+'-engine'}}}];"
