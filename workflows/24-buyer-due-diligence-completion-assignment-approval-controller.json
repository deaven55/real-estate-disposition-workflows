{
  "name": "WholeStack WF-386: Buyer Due-Diligence Completion & Assignment Approval Controller",
  "nodes": [
    {
      "id": "webhook",
      "name": "Assignment Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "wholestack-buyer-assignment-approval",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "normalize",
      "name": "Normalize Assignment Approval Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ],
      "parameters": {
        "jsCode": "var b=$input.first().json.body||$input.first().json;\nreturn [{json:{...b,buyerId:String(b.buyerId||''),dealId:String(b.dealId||''),assignmentId:String(b.assignmentId||''),receivedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "fetch",
      "name": "Fetch Due Diligence Completion Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INSULACRM_API/buyers/assignment-approval-context",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({buyerId:$json.buyerId,dealId:$json.dealId,assignmentId:$json.assignmentId}) }}"
      }
    },
    {
      "id": "evaluate",
      "name": "Evaluate Due Diligence Completion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        930,
        300
      ],
      "parameters": {
        "jsCode": "var d=$input.first().json;\nvar identity=!!d.buyerId&&!!d.dealId&&!!d.assignmentId;\nvar pof=['verified','approved','current'].indexOf(String(d.proofOfFundsStatus||'').toLowerCase())>=0;\nvar docs=d.requiredDocumentsComplete===true;\nvar qualification=d.buyerQualification==='qualified'||d.buyerQualification==='conditional';\nvar lock=d.dealLockStatus==='locked'||d.dealLockStatus==='exclusive';\nvar contract=d.contractReady!==false;\nvar buyerActive=d.buyerActive!==false;\nvar assignmentEligible=d.assignmentEligible!==false;\nvar protectedDeal=['closed','cancelled','disputed'].indexOf(String(d.dealStatus||'').toLowerCase())>=0;\nvar complete=identity&&pof&&docs&&qualification&&lock&&contract&&buyerActive&&assignmentEligible&&!protectedDeal;\nvar missing=[]; if(!pof) missing.push('verified_proof_of_funds'); if(!docs) missing.push('required_documents'); if(!qualification) missing.push('buyer_qualification'); if(!lock) missing.push('exclusive_deal_lock'); if(!contract) missing.push('contract_readiness'); if(!buyerActive) missing.push('active_buyer'); if(!assignmentEligible) missing.push('assignment_eligibility');\nvar status=complete?'approved':protectedDeal?'blocked':missing.length?'pending':'review';\nreturn [{json:{...d,dueDiligenceComplete:complete,assignmentApprovalStatus:status,approvalMissing:missing}}];"
      }
    },
    {
      "id": "guard",
      "name": "Enforce Assignment Approval Guardrails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        300
      ],
      "parameters": {
        "jsCode": "var d=$input.first().json;\nvar approved=d.assignmentApprovalStatus==='approved';\nvar identity=!!d.buyerId&&!!d.dealId&&!!d.assignmentId;\nvar allowed=approved&&identity;\nvar reason=allowed?null:!identity?'missing_identity':d.assignmentApprovalStatus==='blocked'?'deal_protected':(d.approvalMissing||['due_diligence_incomplete'])[0];\nreturn [{json:{...d,assignmentApprovalAllowed:allowed,assignmentApprovalBlockedReason:reason}}];"
      }
    },
    {
      "id": "persist",
      "name": "Persist Assignment Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1390,
        150
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INSULACRM_API/buyers/assignment-approval",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({buyerId:$json.buyerId,dealId:$json.dealId,assignmentId:$json.assignmentId,approvalStatus:$json.assignmentApprovalStatus,dueDiligenceComplete:$json.dueDiligenceComplete,missing:$json.approvalMissing||[],idempotencyKey:'wf386:approval:'+String($json.buyerId)+':'+String($json.assignmentId)}) }}"
      }
    },
    {
      "id": "handoff",
      "name": "Handoff Approved Assignment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        150
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INSULACRM_API/assignments/approved-for-closing",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({buyerId:$json.buyerId,dealId:$json.dealId,assignmentId:$json.assignmentId,approvalStatus:'approved',dueDiligenceComplete:true,idempotencyKey:'wf386:closing:'+String($json.assignmentId)}) }}"
      }
    },
    {
      "id": "respond",
      "name": "Respond Assignment Approval",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1850,
        150
      ],
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseBody": "={{ JSON.stringify({success:true,workflow:'WF-386',assignmentApprovalStatus:$json.assignmentApprovalStatus,dueDiligenceComplete:$json.dueDiligenceComplete,approved:$json.assignmentApprovalAllowed,buyerId:$json.buyerId,assignmentId:$json.assignmentId,missing:$json.approvalMissing||[]}) }}"
      }
    },
    {
      "id": "blocked",
      "name": "Respond Assignment Approval Blocked",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1390,
        500
      ],
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseBody": "={{ JSON.stringify({success:true,workflow:'WF-386',approved:false,assignmentApprovalStatus:$json.assignmentApprovalStatus,reason:$json.assignmentApprovalBlockedReason||'assignment_approval_blocked',buyerId:$json.buyerId||null,assignmentId:$json.assignmentId||null,missing:$json.approvalMissing||[]}) }}"
      }
    }
  ],
  "connections": {
    "Assignment Approval Webhook": {
      "main": [
        [
          {
            "node": "Normalize Assignment Approval Request",
