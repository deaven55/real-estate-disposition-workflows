    {
      "parameters": {
        "jsCode": "const input=$('Normalize Priority Outreach Request').first().json; const ctx=$json.context??$json; const score=Math.max(0,Math.min(100,Number(input.priorityScore)||0)); const dnc=ctx.dnc===true||ctx.suppressed===true; const closed=ctx.closed===true||['closed','cancelled','lost'].includes(String(ctx.leadStatus??'').toLowerCase()); const consent=String(ctx.consentStatus??'unknown').toLowerCase(); const contactable=ctx.contactable!==false; const appointmentAvailable=ctx.appointmentSlotsAvailable!==false; const replyPending=ctx.replyPending===true; const flags=[]; if(dnc)flags.push('dnc_or_suppressed'); if(closed)flags.push('closed_or_cancelled'); if(['denied','revoked'].includes(consent))flags.push('consent_denied_or_revoked'); if(!contactable)flags.push('not_contactable'); if(replyPending)flags.push('seller_reply_pending'); const allowed=!dnc&&!closed&&!['denied','revoked'].includes(consent)&&contactable&&!replyPending; let action='hold_outreach'; let outreachPriority='standard'; let followUpMinutes=1440; if(score>=80||input.tier==='A'){outreachPriority='hot';followUpMinutes=60;} else if(score>=60||input.tier==='B'){outreachPriority='warm';followUpMinutes=240;} else if(score>=40||input.tier==='C'){outreachPriority='standard';followUpMinutes=1440;} else {outreachPriority='nurture';followUpMinutes=4320;} if(allowed){action=input.appointmentRequested||input.nextAction.includes('conversation')?'outreach_and_offer_appointment':'outreach_and_schedule_follow_up';} const template=outreachPriority==='hot'?'hot_seller_priority':outreachPriority==='warm'?'warm_seller_follow_up':outreachPriority==='standard'?'standard_seller_follow_up':'nurture_seller_reengagement'; const idempotencyKey='wf457:'+input.leadId+':'+input.sequenceId+':'+outreachPriority; return [{json:{...input,priorityOutreach:{status:allowed?'ready':'blocked',action,outreachPriority,template,followUpMinutes,appointmentOffer:allowed&&appointmentAvailable,appointmentAvailable,flags,dispatchAllowed:allowed,requiresHumanReview:!allowed||outreachPriority==='hot',confidenceScore:allowed?90:25},idempotencyKey}}];"
      },
