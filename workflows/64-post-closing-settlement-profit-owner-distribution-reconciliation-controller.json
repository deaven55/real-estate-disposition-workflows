      "parameters": {
        "jsCode": "const input=$('Normalize Post-Closing Request').first().json; const ctx=$json.context??$json; const d=ctx.deal??{}; const s=ctx.settlement??{}; const p=ctx.payout??{}; const flags=[]; const n=v=>Number.isFinite(Number(v))?Number(v):null; const gross=n(s.grossRevenue??d.assignmentFee??p.grossRevenue); const purchase=n(d.purchasePrice??s.purchasePrice); const closingCosts=n(s.closingCosts??p.closingCosts)??0; const otherCosts=n(s.otherCosts??p.otherCosts)??0; const assignmentFee=n(s.assignmentFee??d.assignmentFee??p.assignmentFee); const netProfit=n(p.netProfit??s.netProfit)??(gross!==null?gross-closingCosts-otherCosts-(purchase??0):null); const ownerSharePercent=n(p.ownerSharePercent??ctx.ownerSharePercent); const reserveAmount=n(p.reserveAmount??ctx.reserveAmount)??0; const expectedOwnerDistribution=ownerSharePercent!==null&&netProfit!==null?Math.max(0,netProfit*(ownerSharePercent/100)-reserveAmount):null; const recordedOwnerDistribution=n(p.ownerDistribution??ctx.ownerDistribution); const distributionDelta=expectedOwnerDistribution!==null&&recordedOwnerDistribution!==null?recordedOwnerDistribution-expectedOwnerDistribution:null; if(ctx.lifecycleState&&ctx.lifecycleState!=='closed')flags.push('deal_not_closed'); if(ctx.settlementReconciled!==true&&s.reconciled!==true)flags.push('settlement_not_reconciled'); if(ctx.fundsConfirmed!==true&&s.fundsConfirmed!==true)flags.push('funds_not_confirmed'); if(gross===null)flags.push('gross_revenue_missing'); if(netProfit===null)flags.push('net_profit_unavailable'); if(ownerSharePercent!==null&&(ownerSharePercent<0||ownerSharePercent>100))flags.push('invalid_owner_share_percent'); if(distributionDelta!==null&&Math.abs(distributionDelta)>0.01)flags.push('owner_distribution_mismatch'); const ready=flags.length===0; const decision=ready?'reconciled_and_ready_for_reporting':flags.includes('owner_distribution_mismatch')?'hold_and_correct_owner_distribution':'hold_and_complete_post_closing_reconciliation'; const idempotencyKey='wf426:'+input.leadId+':'+input.propertyId+':'+input.dealId+':'+input.assignmentId; return [{json:{...input,postClosingReconciliation:{status:ready?'reconciled':'exception',decision,flags,financials:{grossRevenue:gross,purchasePrice:purchase,assignmentFee,closingCosts,otherCosts,netProfit,ownerSharePercent,reserveAmount,expectedOwnerDistribution,recordedOwnerDistribution,distributionDelta},nextAction:ready?'release_closed_deal_for_final_reporting_and_archive':'correct_post_closing_financial_exceptions',requiresHumanReview:flags.includes('owner_distribution_mismatch')||flags.includes('invalid_owner_share_percent'),confidenceScore:ready?98:Math.max(0,72-flags.length*10)},idempotencyKey}}];"
