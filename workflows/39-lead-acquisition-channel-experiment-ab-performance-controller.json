      ]
    },
    {
      "parameters": {
        "jsCode": "const d=$json; const eligible=(d.variants||[]).filter(v=>Number(v.leads||0)>=10&&Number(v.impressions||0)>=100); const ranked=[...eligible].sort((a,b)=>Number(b.netProfit||0)-Number(a.netProfit||0)||Number(b.leadRate||0)-Number(a.leadRate||0)); let status='insufficient_sample',winnerVariantId=null,leadingVariantId=null,lift=null; if(ranked.length>=2){leadingVariantId=ranked[0].variantId??ranked[0].id??ranked[0].name; const base=Number(ranked[1].leadRate||0),lead=Number(ranked[0].leadRate||0); lift=base>0?(lead-base)/base:null; status=lift!==null&&lift>=0.1?'winner_identified':'leading_variant'; if(status==='winner_identified') winnerVariantId=leadingVariantId;} return [{json:{...d,experimentResult:{status,winnerVariantId,leadingVariantId,relativeLift:lift,eligibleVariantCount:ranked.length,decisionBasis:'lead_rate_with_profit_tiebreaker'}}}];"
