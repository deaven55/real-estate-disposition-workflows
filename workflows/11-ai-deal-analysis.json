{
  "name": "WholeStack WF-011: AI Deal Analysis",
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "wholestack-ai-deal-analysis-v1",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "prepare",
      "name": "Prepare Analysis Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input=$input.first().json.body||$input.first().json; const required=['dealId','address','city','state','zip']; const missing=required.filter(k=>input[k]===undefined||input[k]===null||input[k]===''); if(missing.length)return [{json:{valid:false,errors:missing}}]; return [{json:{valid:true,deal:input}}];"
      }
    },
    {
      "id": "ifvalid",
      "name": "IF Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "strict",
            "leftValue": ""
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "respond400",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        180
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({success:false,errors:$json.errors}) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "llm",
      "name": "AI Deal Analyst",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        700,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.OPENAI_API_KEY }"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:$env.OPENAI_DEAL_ANALYSIS_MODEL || 'gpt-5-mini',input:[{role:'system',content:[{type:'input_text',text:'Analyze only supplied evidence. Never invent comps or market facts. Missing evidence means null values and lower confidence. Return JSON keys arv, repair_estimate, arv_confidence, repair_confidence, overall_confidence, exit_strategy, comp_summary, repair_scope, assumptions, risk_flags, methodology, source.'}]},{role:'user',content:[{type:'input_text',text:JSON.stringify($json.deal)}]}]}) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "parse",
      "name": "Parse AI Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw=$input.first().json; let text=raw.output_text||''; if(!text&&Array.isArray(raw.output)){for(const item of raw.output)for(const c of (item.content||[]))if(c.type==='output_text')text+=c.text||'';} if(!text)return [{json:{valid:false,error:'AI response contained no output text'}}]; try{return [{json:{valid:true,analysis:JSON.parse(text)}}];}catch(e){return [{json:{valid:false,error:'AI output was not valid JSON'}}];}"
      }
    },
    {
      "id": "ifparsed",
      "name": "IF Parsed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1160,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "strict",
            "leftValue": ""
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "parsed",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "respond500",
      "name": "Respond Analysis Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1380,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({success:false,error:$json.error}) }}",
        "options": {
          "responseCode": 502
        }
      }
    },
    {
      "id": "sync",
      "name": "Sync Analysis to InsulaCRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1380,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INSULA_CRM_BASE_URL + '/api/v1/deals/' + $json.dealId + '/analysis' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INSULA_CRM_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ 'ai:deal-analysis:' + $json.dealId + ':v1' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({...$json.analysis,purchase_price:Number($json.purchasePrice || $json.askingPrice || 0),analyzed_by:'openai_deal_analysis_v1'}) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1600,
        -100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({success:true,analysis:$json.analysis,insula:$json}) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Prepare Analysis Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Analysis Context": {
      "main": [
        [
          {
            "node": "IF Valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Valid": {
      "main": [
        [
          {
            "node": "AI Deal Analyst",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Deal Analyst": {
      "main": [
        [
          {
            "node": "Parse AI Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse AI Analysis": {
      "main": [
        [
          {
            "node": "IF Parsed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Parsed": {
      "main": [
        [
          {
            "node": "Sync Analysis to InsulaCRM",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Analysis Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sync Analysis to InsulaCRM": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "active": false
}