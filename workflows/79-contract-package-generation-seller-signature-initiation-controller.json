    {
      "parameters": {
        "jsCode": "const input=$('Normalize Contract Package Request').first().json; const ctx=$json.context??$json; const readiness=ctx.contractReadiness??{}; const flags=[]; const dealState=String(ctx.dealState??ctx.status??'').toLowerCase(); if(['closed','cancelled','disputed','dnc','suppressed'].includes(dealState)||ctx.dnc===true||ctx.suppressed===true)flags.push('deal_or_contact_blocked'); const sellerIdentity=readiness.sellerIdentityVerified===true; const propertyIdentity=readiness.propertyIdentityVerified===true; const sellerAccepted=readiness.sellerAccepted===true; const economicsReady=readiness.economicsReady===true; const requiredDocs=Array.isArray(readiness.requiredDocuments)?readiness.requiredDocuments:[]; const missingDocs=requiredDocs.filter(d=>d.required!==false&&!d.ready); const titleReady=readiness.titleCompanyConfirmed===true; const allPrereqs=sellerIdentity&&propertyIdentity&&sellerAccepted&&economicsReady&&missingDocs.length===0&&titleReady; if(!sellerIdentity)flags.push('seller_identity_not_verified'); if(!propertyIdentity)flags.push('property_identity_not_verified'); if(!sellerAccepted)flags.push('seller_acceptance_missing'); if(!economicsReady)flags.push('economics_not_ready'); if(missingDocs.length)flags.push('required_documents_missing'); if(!titleReady)flags.push('title_company_confirmation_missing'); const packageFields={seller:{sellerId:ctx.sellerId??null,name:ctx.sellerName??null},property:{propertyId:ctx.propertyId??null,address:ctx.propertyAddress??null},deal:{dealId:input.dealId,purchasePrice:ctx.purchasePrice??null,closingDate:ctx.closingDate??null},contract:{contractId:input.contractId,contractType:ctx.contractType??'purchase_agreement',version:ctx.contractVersion??1,requiredSigners:ctx.requiredSigners??['seller']}}; let decision=allPrereqs&&!flags.length?'package_ready':'blocked'; let nextAction=decision==='package_ready'?'generate_contract_document_and_initiate_seller_signature':'collect_missing_contract_prerequisites'; const idempotencyKey='wf441:'+input.leadId+':'+input.dealId+':'+input.contractId; return [{json:{...input,contractPackageDecision:{status:decision==='package_ready'?'ready':'blocked',decision,nextAction,packageFields,missingRequirements:missingDocs.map(d=>d.name??d.id??'required_document'),flags,requiresHumanReview:decision!=='package_ready',confidenceScore:decision==='package_ready'?96:20},idempotencyKey}}];"
      },
