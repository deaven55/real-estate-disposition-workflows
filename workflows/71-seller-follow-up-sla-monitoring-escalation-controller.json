      "parameters": {
        "jsCode": "const input=$('Normalize Seller SLA Request').first().json; const ctx=$json.context??$json; const leads=Array.isArray(ctx.leads)?ctx.leads:[]; const n=v=>Number.isFinite(Number(v))?Number(v):0; const now=new Date(input.asOfDate).getTime(); const defaultSla={hot:60,warm:240,standard:1440,nurture:4320}; const sla={...defaultSla,...(ctx.slaMinutes??{})}; const active=leads.filter(l=>!['closed','cancelled','dnc','suppressed'].includes(String(l.status??'').toLowerCase())); const monitored=active.map(l=>{const queue=String(l.queue??(n(l.priorityScore)>=80?'hot':n(l.priorityScore)>=60?'warm':n(l.priorityScore)>=35?'standard':'nurture')).toLowerCase(); const lastContact=l.lastContactAt??l.lastOutreachAt??l.lastActivityAt??null; const dueAt=l.nextFollowUpAt??null; const elapsed=lastContact?Math.max(0,(now-new Date(lastContact).getTime())/60000):null; const slaLimit=n(sla[queue]??sla.standard); const overdue=dueAt?new Date(dueAt).getTime()<now:(elapsed!==null&&elapsed>slaLimit); const urgency=queue==='hot'&&overdue?'critical':overdue?'high':queue==='hot'?'priority':'normal'; return{leadId:l.leadId??l.id,queue,priorityScore:n(l.priorityScore),lastContactAt:lastContact,nextFollowUpAt:dueAt,elapsedMinutes:elapsed,slaMinutes:slaLimit,overdue,urgency,assignedTo:l.assignedTo??l.ownerId??null};}); const overdue=monitored.filter(x=>x.overdue); const critical=overdue.filter(x=>x.urgency==='critical'); const escalationActions=overdue.map(x=>({leadId:x.leadId,action:x.urgency==='critical'?'immediate_human_escalation':x.queue==='warm'?'priority_follow_up':'schedule_follow_up',queue:x.queue,assignedTo:x.assignedTo})); const status=monitored.length?'assessed':'blocked'; const idempotencyKey='wf433:'+input.portfolioId+':'+input.asOfDate; return [{json:{...input,sellerFollowUpSLA:{status,summary:{activeLeads:monitored.length,overdueFollowUps:overdue.length,criticalEscalations:critical.length,overdueRate:monitored.length?overdue.length/monitored.length:0},slaMinutes:sla,leadAssessments:monitored,escalationActions,flags:monitored.length?[]:['no_active_seller_leads'],nextAction:critical.length?'escalate_critical_seller_follow_ups':overdue.length?'execute_overdue_follow_up_queue':'maintain_sla_monitoring',confidenceScore:monitored.length?93:20},idempotencyKey}}];"
