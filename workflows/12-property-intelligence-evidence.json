{
  "name": "WholeStack WF-012: Property Intelligence Evidence Pipeline",
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "wholestack-property-intelligence-v1",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "prepare",
      "name": "Prepare Evidence Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input=$input.first().json.body||$input.first().json; const missing=['dealId'].filter(k=>input[k]===undefined||input[k]===null||input[k]===''); const evidence=Array.isArray(input.evidence)?input.evidence:[]; return [{json:{valid:missing.length===0,errors:missing,evidence,dealId:input.dealId,analysisContext:input.analysisContext||{}}}];"
      }
    },
    {
      "id": "ifvalid",
      "name": "IF Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "strict",
            "leftValue": ""
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "respond400",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        180
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({success:false,errors:$json.errors}) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "getdeal",
      "name": "Get Deal from InsulaCRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        680,
        -80
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.INSULA_CRM_BASE_URL + '/api/v1/deals/' + $json.dealId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INSULA_CRM_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "normalize",
      "name": "Normalize Evidence Bundle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        -80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const req=$(\"Prepare Evidence Request\").first().json; const deal=$input.first().json; const evidence=req.evidence.map((e,i)=>({evidence_type:e.evidence_type||e.type||'property_observation',source:e.source||'user_supplied',source_record_id:e.source_record_id||e.record_id||null,observed_at:e.observed_at||new Date().toISOString(),confidence:e.confidence===undefined?null:Number(e.confidence),payload:e.payload||e})); return [{json:{dealId:req.dealId,deal,evidence,analysisContext:req.analysisContext}}];"
      }
    },
    {
      "id": "store",
      "name": "Store Evidence in InsulaCRM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        -80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data=$input.first().json; const results=[]; for(const e of data.evidence){const key='property-intel:evidence:'+data.dealId+':'+(e.source||'unknown')+':'+(e.source_record_id||JSON.stringify(e.payload).slice(0,120)); const r=await this.helpers.httpRequest({method:'POST',url:$env.INSULA_CRM_BASE_URL+'/api/v1/deals/'+data.dealId+'/evidence',headers:{'X-API-Key':$env.INSULA_CRM_API_KEY,'Content-Type':'application/json','Idempotency-Key':key},body:e,json:true,timeout:30000}); results.push(r);} return [{json:{...data,storedEvidence:results}}];"
      }
    },
    {
      "id": "buildanalysis",
      "name": "Build Evidence-First Analysis Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        -80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$input.first().json; const evidence=d.evidence.map((e,i)=>({type:e.evidence_type,source:e.source,record_id:e.source_record_id,confidence:e.confidence,observed_at:e.observed_at,payload:e.payload})); return [{json:{dealId:d.dealId,analysisContext:{deal:d.deal,evidence,additional_context:d.analysisContext}}}];"
      }
    },
    {
      "id": "callai",
      "name": "Call WF-011 AI Deal Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1640,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_INTERNAL_BASE_URL + '/webhook/wholestack-ai-deal-analysis-v1' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({...$json.analysisContext,dealId:$json.dealId}) }}",
        "options": {
          "timeout": 90000
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1880,
        -80
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{{ JSON.stringify({success:true,dealId:$(\"Build Evidence-First Analysis Context\").first().json.dealId,analysis:$json}) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Prepare Evidence Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Evidence Request": {
      "main": [
        [
          {
            "node": "IF Valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Valid": {
      "main": [
        [
          {
            "node": "Get Deal from InsulaCRM",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Deal from InsulaCRM": {
      "main": [
        [
          {
            "node": "Normalize Evidence Bundle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Evidence Bundle": {
      "main": [
        [
          {
            "node": "Store Evidence in InsulaCRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store Evidence in InsulaCRM": {
      "main": [
        [
          {
            "node": "Build Evidence-First Analysis Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Evidence-First Analysis Context": {
      "main": [
        [
          {
            "node": "Call WF-011 AI Deal Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call WF-011 AI Deal Analysis": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "active": false
}