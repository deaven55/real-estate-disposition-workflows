    {
      "parameters": {
        "jsCode": "const input=$('Normalize Seller Response').first().json; const ctx=$json.context??$json; const text=input.responseText.toLowerCase(); const suppressed=Boolean(ctx.suppressed||ctx.dnc||input.suppressed||input.dnc); const closed=Boolean(ctx.closed||input.closed); const has=(...terms)=>terms.some(t=>text.includes(t)); let intent='other'; if(has('do not contact','stop texting','stop contacting','remove me','unsubscribe')) intent='dnc'; else if(has('yes','interested','i want to sell','let’s do it','lets do it','accept','deal')) intent='interested'; else if(has('call me','call us','give me a call','phone me')) intent='call_request'; else if(has('offer','price','how much','what can you pay','counter')) intent='offer_question'; else if(has('not interested','no thanks','no thank you','not selling')) intent='not_interested'; else if(has('later','next month','next year','not ready','maybe')) intent='nurture'; const sentiment=has('angry','mad','stop','leave me alone')?'negative':has('great','thanks','interested','yes')?'positive':'neutral'; const route=suppressed||closed?'blocked':intent==='dnc'?'dnc':intent==='interested'?'sales_follow_up':intent==='call_request'?'call_follow_up':intent==='offer_question'?'offer_follow_up':intent==='not_interested'?'closed_lost':intent==='nurture'?'nurture':'manual_review'; const nextAction=route==='dnc'?'suppress_future_outreach':route==='sales_follow_up'?'contact_seller_and_qualify':route==='call_follow_up'?'schedule_or_place_call':route==='offer_follow_up'?'prepare_offer_context':route==='closed_lost'?'stop_active_sequence':route==='nurture'?'schedule_future_follow_up':'human_review_response'; const idempotencyKey='wf408:'+input.leadId+':'+(input.responseId||input.receivedAt); return [{json:{...input,context:ctx,responseAnalysis:{intent,sentiment,route,nextAction,confidence:intent==='other'?45:75,evidence:{matchedKeywords:text.length>0?text.slice(0,240):''}},guardrails:{suppressed,closed},idempotencyKey}}}];"
      },
