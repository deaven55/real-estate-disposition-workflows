    {
      "parameters": {
        "jsCode": "const input=$('Normalize Budget Optimization Request').first().json; const ctx=$json.context??$json; const sources=Array.isArray(ctx.sources)?ctx.sources:[]; const n=v=>Number.isFinite(Number(v))?Number(v):0; const available=input.availableBudget!==null?input.availableBudget:n(ctx.availableBudget); const scored=sources.map(s=>{const leads=n(s.leads),qualified=n(s.qualifiedLeads),contracts=n(s.contracts),closed=n(s.closedDeals),spend=n(s.spend),profit=n(s.netProfit),closeRate=leads?closed/leads:0,profitPerLead=leads?profit/leads:0,roiBase=spend+n(s.totalInvestment),roi=roiBase?profit/roiBase:null; let score=0;if(roi!==null)score+=Math.max(-1,Math.min(3,roi))*40;score+=Math.min(30,closeRate*100*0.5);score+=Math.max(-20,Math.min(30,profitPerLead/1000*10)); if(closed<2)score-=10; const recommendation=closed<2?'test_with_tracking':roi!==null&&roi<0?'reduce_or_pause':score>=70?'scale':score>=45?'maintain_and_optimize':'reduce_or_pause'; return {...s,closeRate,profitPerLead,roi,optimizationScore:Math.round(score*100)/100,recommendation};}).sort((a,b)=>b.optimizationScore-a.optimizationScore); const totalWeight=scored.reduce((s,x)=>s+Math.max(0,x.optimizationScore),0); const allocations=scored.map(x=>{const weight=totalWeight?Math.max(0,x.optimizationScore)/totalWeight:0;const proposed=available!==null?available*weight:0;const minBudget=n(x.minBudget);const maxBudget=n(x.maxBudget);const bounded=Math.max(minBudget,Math.min(maxBudget||proposed,proposed));return {...x,proposedBudget:Math.round(bounded*100)/100};}); const allocated=allocations.reduce((s,x)=>s+x.proposedBudget,0); const delta=available!==null?available-allocated:null; const idempotencyKey='wf430:'+input.portfolioId+':'+input.period+':'+input.asOfDate; return [{json:{...input,budgetAllocationIntelligence:{status:allocations.length?'recommended':'blocked',availableBudget:available,allocatedBudget:allocated,unallocatedBudget:delta,sourceRecommendations:allocations,flags:allocations.length?[]:['no_source_performance_data'],nextAction:allocations.length?'review_and_apply_budget_allocation':'collect_source_performance_data',confidenceScore:allocations.length?88:25},idempotencyKey}}];"
      },
