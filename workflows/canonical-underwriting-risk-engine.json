        "jsCode": "const b=$json.body??$json; const eventType=String(b.eventType??b.type??'underwrite').trim().toLowerCase(); const leadId=String(b.leadId??'').trim(); const propertyId=String(b.propertyId??'').trim(); const dealId=String(b.dealId??'').trim(); const portfolioId=String(b.portfolioId??'').trim(); const idempotencyKey=String(b.idempotencyKey??('underwriting:'+eventType+':'+leadId+':'+propertyId+':'+dealId)).trim(); return [{json:{...b,eventType,leadId,propertyId,dealId,portfolioId,idempotencyKey,receivedAt:new Date().toISOString()}}];"
      },
