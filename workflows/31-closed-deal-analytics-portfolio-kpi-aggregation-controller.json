{
  "name": "WF-393 — Closed-Deal Analytics & Portfolio KPI Aggregation Controller",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "closed-deal-analytics-portfolio-kpi",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wf393-webhook",
      "name": "Closed Deal Analytics Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nconst required = ['dealId'];\nconst missing = required.filter(k => b[k] === undefined || b[k] === null || b[k] === '');\nif (missing.length) throw new Error('Missing required analytics fields: ' + missing.join(', '));\nconst eventType = String(b.eventType ?? 'closed_deal_archived').toLowerCase();\nconst idempotencyKey = String(b.idempotencyKey ?? ('wf393:analytics:' + String(b.dealId) + ':' + eventType + ':' + String(b.period ?? 'all-time')));\nreturn [{ json: { ...b, dealId: String(b.dealId), eventType, idempotencyKey } }];"
      },
      "id": "wf393-normalize",
      "name": "Normalize Analytics Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "https://YOUR_INSULACRM_API/analytics/closed-deal-context",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.INSULACRM_API_KEY}}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{$json.idempotencyKey}}:context"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "wf393-context",
      "name": "Fetch Closed Deal Analytics Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const c = $json;\nconst deals = Array.isArray(c.closedDeals) ? c.closedDeals : (Array.isArray(c.data?.closedDeals) ? c.data.closedDeals : []);\nconst current = c.currentDeal ?? c.deal ?? c.data?.currentDeal ?? c.data?.deal ?? {};\nconst rows = deals.length ? deals : [current];\nconst closedRows = rows.filter(d => String(d.status ?? d.state ?? '').toLowerCase().includes('closed'));\nconst validRows = closedRows.filter(d => Number.isFinite(Number(d.netProfit ?? d.profit ?? 0)));\nconst count = validRows.length;\nconst grossRevenue = validRows.reduce((s,d)=>s+Number(d.grossRevenue ?? d.assignmentFee ?? 0),0);\nconst netProfit = validRows.reduce((s,d)=>s+Number(d.netProfit ?? d.profit ?? 0),0);\nconst assignmentFees = validRows.reduce((s,d)=>s+Number(d.assignmentFee ?? 0),0);\nconst closingCosts = validRows.reduce((s,d)=>s+Number(d.closingCosts ?? 0),0);\nconst otherCosts = validRows.reduce((s,d)=>s+Number(d.otherCosts ?? 0),0);\nconst avgNetProfit = count ? netProfit / count : 0;\nconst avgAssignmentFee = count ? assignmentFees / count : 0;\nconst profitMargin = grossRevenue ? netProfit / grossRevenue : 0;\nconst profitableDeals = validRows.filter(d=>Number(d.netProfit ?? d.profit ?? 0)>0).length;\nconst lossDeals = validRows.filter(d=>Number(d.netProfit ?? d.profit ?? 0)<0).length;\nconst winRate = count ? profitableDeals / count : 0;\nconst period = String($json.period ?? c.period ?? 'all-time');\nconst analytics = { period, closedDealCount: count, grossRevenue, netProfit, assignmentFees, closingCosts, otherCosts, averageNetProfit: avgNetProfit, averageAssignmentFee: avgAssignmentFee, profitMargin, profitableDeals, lossDeals, winRate };\nreturn [{ json: { ...$json, analytics, analyticsEligible: count > 0, closedRows: validRows } }];"
      },
      "id": "wf393-aggregate",
      "name": "Aggregate Closed Deal KPIs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "analytics-eligible",
              "leftValue": "={{$json.analyticsEligible}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
