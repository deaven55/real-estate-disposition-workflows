    {
      "parameters": {
        "jsCode": "const c = $json;\nconst deal = c.deal ?? c.data?.deal ?? {};\nconst source = c.source ?? c.leadSource ?? deal.source ?? c.data?.source ?? {};\nconst acquisition = c.acquisition ?? c.data?.acquisition ?? {};\nconst financial = c.financial ?? c.data?.financial ?? {};\nconst closed = String(deal.state ?? deal.status ?? '').toLowerCase();\nconst issues = [];\nif (!['closed','closed_settled'].includes(closed)) issues.push('deal_not_closed:' + closed);\nconst grossRevenue = Number(financial.grossRevenue ?? deal.grossRevenue ?? deal.assignmentFee ?? 0);\nconst totalCosts = Number(financial.totalCosts ?? ((Number(financial.closingCosts ?? deal.closingCosts ?? 0)) + (Number(financial.otherCosts ?? deal.otherCosts ?? 0)) + (Number(acquisition.acquisitionCost ?? 0))));\nconst netProfit = Number(financial.netProfit ?? deal.netProfit ?? (grossRevenue - totalCosts));\nconst acquisitionCost = Number(acquisition.acquisitionCost ?? acquisition.marketingCost ?? 0);\nconst sourceSpend = Number(source.spend ?? source.cost ?? acquisition.sourceSpend ?? 0);\nconst totalInvestment = acquisitionCost + sourceSpend;\nconst roi = totalInvestment > 0 ? netProfit / totalInvestment : null;\nconst profitMultiple = totalInvestment > 0 ? netProfit / totalInvestment : null;\nconst daysToClose = Number(deal.daysToClose ?? acquisition.daysToClose ?? 0);\nconst leadToContractDays = Number(acquisition.leadToContractDays ?? 0);\nconst contractToCloseDays = Number(acquisition.contractToCloseDays ?? 0);\nconst sourceName = String(source.name ?? source.channel ?? source.type ?? 'unknown');\nconst campaign = String(source.campaign ?? acquisition.campaign ?? '');\nconst dispositionChannel = String(deal.dispositionChannel ?? c.dispositionChannel ?? 'unknown');\nif (![grossRevenue,totalCosts,netProfit,acquisitionCost,sourceSpend,totalInvestment].every(Number.isFinite)) issues.push('financial_values_not_numeric');\nif (grossRevenue < 0 || totalCosts < 0 || acquisitionCost < 0 || sourceSpend < 0) issues.push('negative_financial_input');\nif (daysToClose < 0 || leadToContractDays < 0 || contractToCloseDays < 0) issues.push('duration_invalid');\nconst eligible = issues.length === 0;\nreturn [{ json: { ...$json, deal, source, acquisition, financial, closed, grossRevenue, totalCosts, netProfit, acquisitionCost, sourceSpend, totalInvestment, roi, profitMultiple, daysToClose, leadToContractDays, contractToCloseDays, sourceName, campaign, dispositionChannel, issues, analyticsEligible: eligible } }];"
      },
