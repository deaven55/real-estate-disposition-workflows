# Canonical platform deployment environment
# Copy to your deployment environment; do not commit real secrets.

N8N_BASE_URL=https://YOUR_N8N_HOST
N8N_WEBHOOK_TOKEN=CONFIGURE_IN_DEPLOYMENT_SECRET
INSULACRM_API_BASE_URL=https://YOUR_INSULACRM_API_HOST
INSULACRM_API_TOKEN=CONFIGURE_IN_DEPLOYMENT_SECRET

# n8n webhook paths
CANONICAL_PLATFORM_WEBHOOK_PATH=/webhook/canonical-platform-integration-hardening
CANONICAL_LIFECYCLE_HANDOFF_WEBHOOK_PATH=/webhook/canonical-lifecycle-handoff
PLATFORM_EVENT_ROUTER_WEBHOOK_PATH=/webhook/platform-event-router

# Configure the actual InsulaCRM API credential in n8n Credentials.
# Never place bearer tokens, API keys, or passwords in this file.

# Provider adapter configuration
COMMUNICATIONS_PROVIDER=CONFIGURE_PROVIDER
COMMUNICATIONS_API_BASE_URL=https://YOUR_COMMUNICATIONS_PROVIDER_HOST
COMMUNICATIONS_API_TOKEN=CONFIGURE_IN_DEPLOYMENT_SECRET
ESIGNATURE_PROVIDER=CONFIGURE_PROVIDER
ESIGNATURE_API_BASE_URL=https://YOUR_ESIGNATURE_PROVIDER_HOST
ESIGNATURE_API_TOKEN=CONFIGURE_IN_DEPLOYMENT_SECRET
ESIGNATURE_CREATE_PACKAGE_PATH=/packages
ESIGNATURE_VOID_PACKAGE_PATH=/packages/void
TITLE_CLOSING_PROVIDER=CONFIGURE_PROVIDER
TITLE_CLOSING_API_BASE_URL=https://YOUR_TITLE_CLOSING_PROVIDER_HOST
TITLE_CLOSING_API_TOKEN=CONFIGURE_IN_DEPLOYMENT_SECRET
FUNDS_PROVIDER=CONFIGURE_PROVIDER
FUNDS_API_BASE_URL=https://YOUR_FUNDS_PROVIDER_HOST
FUNDS_API_TOKEN=CONFIGURE_IN_DEPLOYMENT_SECRET

# Shared callback authentication secret for provider callbacks
PROVIDER_CALLBACK_SHARED_TOKEN=CONFIGURE_IN_DEPLOYMENT_SECRET

# Optional provider operation paths (override vendor-neutral defaults)
COMMUNICATIONS_SEND_MESSAGE_PATH=/messages
ESIGNATURE_CREATE_PACKAGE_PATH=/packages
ESIGNATURE_VOID_PACKAGE_PATH=/packages/void
TITLE_CLOSING_CREATE_TITLE_ORDER_PATH=/title-orders
TITLE_CLOSING_REQUEST_CLOSING_PATH=/closings
FUNDS_CONFIRM_FUNDING_PATH=/funding/confirm

# Provider contract test mode: true = adapter-only dry run; false = real provider calls
PROVIDER_CONTRACT_DRY_RUN=true

# Provider webhook paths
PROVIDER_ADAPTER_WEBHOOK_PATH=/webhook/canonical-provider-adapter
PROVIDER_CALLBACK_WEBHOOK_PATH=/webhook/canonical-provider-callback
