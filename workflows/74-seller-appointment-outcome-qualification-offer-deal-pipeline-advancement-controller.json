    {
      "parameters": {
        "jsCode": "const input=$('Normalize Appointment Outcome').first().json; const ctx=$json.context??$json; const blocked=['dnc','suppressed','closed','cancelled']; const leadStatus=String(ctx.leadStatus??ctx.status??'').toLowerCase(); const flags=[]; if(blocked.includes(leadStatus)||ctx.dnc===true||ctx.suppressed===true)flags.push('contact_blocked'); const positive=['interested','motivated','ready_to_sell','offer_requested','appointment_completed']; const qualified=['qualified','high_motivation','property_ready','deal_candidate']; const negative=['not_interested','no_longer_selling','wrong_number','unqualified']; const nurture=['needs_time','follow_up_later','not_ready']; const outcome=input.outcome; let pipelineState='manual_review',nextAction='review_appointment_outcome',advancement='human_review'; if(flags.length){pipelineState='blocked';nextAction='stop_pipeline_advancement';advancement='blocked';} else if(negative.includes(outcome)){pipelineState='closed_lost';nextAction='record_closed_lost';advancement='closed_lost';} else if(nurture.includes(outcome)){pipelineState='nurture';nextAction='schedule_nurture_follow_up';advancement='nurture';} else if(qualified.includes(outcome)){pipelineState='qualified';nextAction='run_underwriting_and_offer_strategy';advancement='underwriting';} else if(positive.includes(outcome)){pipelineState='sales_follow_up';nextAction=ctx.offerReady===true?'prepare_offer':'continue_seller_qualification';advancement=ctx.offerReady===true?'offer_ready':'qualification';} const score=Number(ctx.motivationScore??ctx.priorityScore??0); const propertyComplete=ctx.propertyDataComplete===true; const financialComplete=ctx.financialDataComplete===true; const qualificationComplete=qualified.includes(outcome)||score>=70; const readyForUnderwriting=qualificationComplete&&propertyComplete&&financialComplete&&!flags.length; const readyForOffer=readyForUnderwriting&&ctx.underwritingReady===true; if(readyForOffer){pipelineState='offer_ready';nextAction='execute_seller_offer_strategy';advancement='offer';} else if(readyForUnderwriting&&pipelineState!=='blocked'&&pipelineState!=='closed_lost'&&pipelineState!=='nurture'){pipelineState='underwriting';nextAction='complete_underwriting_before_offer';advancement='underwriting';} const idempotencyKey='wf436:'+input.leadId+':'+input.appointmentId+':'+outcome; return [{json:{...input,appointmentPipelineDecision:{status:flags.length?'blocked':'evaluated',pipelineState,nextAction,advancement,qualification:{motivationScore:score,qualificationComplete,propertyDataComplete:propertyComplete,financialDataComplete:financialComplete},readiness:{readyForUnderwriting,readyForOffer},flags,requiresHumanReview:pipelineState==='manual_review',confidenceScore:flags.length?10:(pipelineState==='manual_review'?55:93)},idempotencyKey}}];"
      },
