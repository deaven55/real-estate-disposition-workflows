    {
      "parameters": {
        "jsCode": "const input=$('Normalize Negotiation Action').first().json; const ctx=$json.context??$json; const n=v=>Number.isFinite(Number(v))?Number(v):0; const protectedMao=n(ctx.protectedMAO??ctx.protectedMao); const currentOffer=n(ctx.currentOffer); const latestCounteroffer=n(ctx.latestCounteroffer??ctx.counteroffer); const maxConcession=Math.max(0,n(ctx.maxConcession??(protectedMao-currentOffer))); const configuredStep=Math.max(0,n(ctx.concessionStep??(maxConcession*0.25))); const sellerMotivation=Math.max(0,Math.min(100,n(ctx.motivationScore??50))); const risk=String(ctx.riskLevel??'medium').toLowerCase(); const dnc=ctx.dnc===true||ctx.suppressed===true; const blocked=ctx.closed===true||['closed','cancelled','disputed'].includes(String(ctx.dealStatus??'').toLowerCase()); let revisedOffer=currentOffer; let dispatchAllowed=false; let status='blocked'; let nextFollowUpMinutes=1440; let template='negotiation_follow_up'; let rationale=''; const flags=[]; if(dnc)flags.push('dnc_or_suppressed'); if(blocked)flags.push('closed_or_blocked_deal'); if(protectedMao<=0)flags.push('missing_protected_mao'); if(latestCounteroffer>protectedMao)flags.push('counteroffer_above_protected_mao'); if(input.action.includes('concession')||input.action.includes('revised')){const remaining=Math.max(0,protectedMao-currentOffer); const step=Math.min(configuredStep,remaining); revisedOffer=Math.min(protectedMao,currentOffer+step); status=revisedOffer>currentOffer?'revised_offer_ready':'hold_or_review'; dispatchAllowed=!dnc&&!blocked&&protectedMao>0&&revisedOffer>0&&revisedOffer<=protectedMao; rationale=sellerMotivation>=70?'Higher motivation supports a controlled concession within the protected ceiling.':'Use a measured concession while preserving the protected ceiling.'; nextFollowUpMinutes=sellerMotivation>=70?240:1440;} else if(input.action.includes('accept')||input.action.includes('contract')){revisedOffer=latestCounteroffer>0?Math.min(latestCounteroffer,protectedMao):currentOffer; status='contract_ready'; dispatchAllowed=false; template='acceptance_and_contract_next_steps'; rationale='Seller acceptance path detected; move to contract readiness rather than negotiating beyond the protected ceiling.'; nextFollowUpMinutes=60;} else if(input.action.includes('walk')||input.action.includes('reengage')){status='reengagement_or_walkaway';dispatchAllowed=!dnc&&!blocked;template='reengagement_or_value_follow_up';nextFollowUpMinutes=sellerMotivation>=70?1440:4320;rationale=sellerMotivation>=70?'Re-engage because motivation remains meaningful.':'Pause and re-engage later rather than exceeding the protected ceiling.';} else {status='human_review';rationale='Unrecognized negotiation action requires review.';} if(risk==='high'||risk==='critical')flags.push('elevated_deal_risk'); const confidence=status==='human_review'||flags.includes('missing_protected_mao')?35:90; const idempotencyKey='wf460:'+input.leadId+':'+input.dealId+':'+(input.counterofferId||'none')+':'+input.action; return [{json:{...input,revisedOfferPlan:{status,revisedOffer,currentOffer,latestCounteroffer,protectedMAO,concessionAmount:Math.max(0,revisedOffer-currentOffer),dispatchAllowed,template,rationale,nextFollowUpMinutes,flags,requiresHumanReview:status==='human_review'||risk==='high'||risk==='critical',confidenceScore:confidence},idempotencyKey}}];"
      },
