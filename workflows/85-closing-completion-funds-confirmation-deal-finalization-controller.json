      "parameters": {
        "jsCode": "const input=$('Normalize Closing Completion Request').first().json; const ctx=$json.context??$json; const flags=[]; const state=String(ctx.dealState??ctx.status??'').toLowerCase(); if(['cancelled','disputed','dnc','suppressed'].includes(state)||ctx.dnc===true||ctx.suppressed===true)flags.push('deal_or_contact_blocked'); const executionState=String(ctx.contractExecutionState??'').toLowerCase(); if(!['executed','fully_executed','contract_executed'].includes(executionState))flags.push('contract_not_executed'); const titleCleared=ctx.titleCleared===true||ctx.titleClearanceState==='cleared'; if(!titleCleared)flags.push('title_not_cleared'); const settlementReconciled=ctx.settlementReconciled===true||ctx.settlementState==='reconciled'; if(!settlementReconciled)flags.push('settlement_not_reconciled'); const n=v=>Number.isFinite(Number(v))?Number(v):0; const closing=ctx.closing??{}; const closingCompleted=closing.completed===true||['completed','closed','funds_confirmed'].includes(String(closing.status??'').toLowerCase()); const completionAt=String(closing.completedAt??ctx.closingCompletedAt??'').trim(); const fundsConfirmed=closing.fundsConfirmed===true||ctx.fundsConfirmed===true; const buyerFundsConfirmed=closing.buyerFundsConfirmed===true||ctx.buyerFundsConfirmed===true; const sellerPayoffConfirmed=closing.sellerPayoffConfirmed===true||ctx.sellerPayoffConfirmed===true; const totalFunds=n(closing.totalFunds??ctx.totalFunds); if(!closingCompleted)flags.push('closing_not_completed'); if(!completionAt)flags.push('closing_completion_timestamp_missing'); if(!fundsConfirmed)flags.push('funds_not_confirmed'); if(!buyerFundsConfirmed)flags.push('buyer_funds_not_confirmed'); if(!sellerPayoffConfirmed)flags.push('seller_payoff_not_confirmed'); if(!(totalFunds>0))flags.push('total_funds_missing'); const finalizable=flags.length===0; let decision='hold_for_closing_completion',nextAction='resolve_closing_completion_requirements',lifecycleState='closing_pending'; if(flags.includes('deal_or_contact_blocked')){decision='blocked';nextAction='stop_deal_finalization';lifecycleState='blocked';}else if(finalizable){decision='deal_finalized_closed';nextAction='trigger_post_closing_reconciliation_and_archive';lifecycleState='closed';} const evidence={closingCompleted,completionAt:completionAt||null,fundsConfirmed,buyerFundsConfirmed,sellerPayoffConfirmed,totalFunds}; const idempotencyKey='wf447:'+input.leadId+':'+input.dealId+':'+input.settlementId+':'+input.closingEventId; return [{json:{...input,closingFinalizationDecision:{status:lifecycleState,decision,nextAction,executionState,titleCleared,settlementReconciled,evidence,flags,requiresHumanReview:!finalizable,confidenceScore:finalizable?99:25},idempotencyKey}}];"
