    {
      "parameters": {
        "jsCode": "const input=$('Normalize Lead Routing Input').first().json; const ctx=$json.context??$json; const suppressed=Boolean(ctx.suppressed||input.suppressed); const dnc=Boolean(ctx.dnc||input.dnc); const status=String(ctx.leadStatus??input.leadStatus??'active').toLowerCase(); const qualification=ctx.qualification??input.qualification??{}; const score=Math.max(0,Math.min(100,Number(input.priorityScore||qualification.priorityScore||0))); const tier=String(input.tier||qualification.tier||'C').toUpperCase(); const available=Array.isArray(ctx.assignees)?ctx.assignees:[]; const eligible=available.filter(a=>a.active!==false&&!a.suppressed&&!a.dnc); const ranked=eligible.map(a=>{const capacity=Math.max(0,Number(a.capacityRemaining??a.capacity??0)); const specialty=Number(a.specialtyScore??50); const geography=Number(a.geographyScore??50); const workload=Number(a.workloadScore??50); const score=(capacity>0?35:0)+specialty*.25+geography*.2+workload*.3; return {...a,routingScore:Math.round(score*100)/100};}).sort((a,b)=>b.routingScore-a.routingScore); const chosen=ranked[0]??null; const queue=score>=80?'priority_hot':score>=60?'priority_warm':score>=40?'standard': 'nurture'; const route=suppressed||dnc?'blocked':status==='closed'||status==='invalid'?'blocked':chosen?'assigned':'queued'; const reason=route==='blocked'?(suppressed?'suppressed':dnc?'dnc':status):chosen?'best_eligible_assignee':'no_eligible_assignee'; const idempotencyKey='wf406:'+input.leadId+':'+queue; return [{json:{...input,context:ctx,routing:{route,queue,reason,assignedTo:chosen?.assigneeId??chosen?.id??null,assignedName:chosen?.name??null,routingScore:chosen?.routingScore??null,eligibleAssigneeCount:ranked.length,priorityScore:score,tier,recommendedSlaHours:queue==='priority_hot'?1:queue==='priority_warm'?4:queue==='standard'?24:72},idempotencyKey}}}];"
      },
