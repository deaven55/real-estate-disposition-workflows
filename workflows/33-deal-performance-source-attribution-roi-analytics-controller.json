      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nif (b.dealId === undefined || b.dealId === null || b.dealId === '') throw new Error('Missing required analytics field: dealId');\nconst eventType = String(b.eventType ?? 'deal_closed').toLowerCase();\nconst idempotencyKey = String(b.idempotencyKey ?? ('wf395:roi:' + String(b.dealId) + ':' + eventType + ':' + String(b.period ?? 'all-time')));\nreturn [{ json: { ...b, dealId: String(b.dealId), eventType, idempotencyKey } }];"
      },
