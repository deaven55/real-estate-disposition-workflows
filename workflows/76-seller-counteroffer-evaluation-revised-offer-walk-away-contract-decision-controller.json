      "parameters": {
        "jsCode": "const input=$('Normalize Seller Counteroffer').first().json; const ctx=$json.context??$json; const n=v=>Number.isFinite(Number(v))?Number(v):0; const counter=n(ctx.counterofferAmount??input.counterofferAmount); const currentOffer=n(ctx.currentOfferAmount??input.currentOfferAmount); const protectedMao=n(ctx.protectedMao); const arv=n(ctx.arv); const repairs=n(ctx.repairs); const dealState=String(ctx.dealState??ctx.status??'').toLowerCase(); const blockedStates=['closed','cancelled','disputed','dnc','suppressed']; const flags=[]; if(blockedStates.includes(dealState)||ctx.dnc===true||ctx.suppressed===true)flags.push('deal_or_contact_blocked'); if(counter<=0)flags.push('invalid_counteroffer_amount'); if(protectedMao>0&&counter>protectedMao)flags.push('counteroffer_above_protected_mao'); const gap=currentOffer>0?counter-currentOffer:null; const gapPct=currentOffer>0?gap/currentOffer:null; const maoGap=protectedMao>0?protectedMao-counter:null; const maoUtilization=protectedMao>0?counter/protectedMao:null; const sellerMotivation=n(ctx.sellerMotivationScore??ctx.motivationScore); const risk=String(ctx.riskLevel??'medium').toLowerCase(); let decision='human_review',nextAction='review_counteroffer',revisedOffer=null,walkAway=false,contractReady=false; if(flags.includes('deal_or_contact_blocked')){decision='blocked';nextAction='stop_negotiation';}else if(flags.includes('invalid_counteroffer_amount')){decision='human_review';nextAction='request_valid_counteroffer';}else if(protectedMao>0&&counter>protectedMao){decision='walk_away_or_reengage';nextAction='reject_above_mao_and_reengage';walkAway=true;}else if(protectedMao>0&&counter<=protectedMao){if(counter<=currentOffer&&currentOffer>0){decision='contract_ready';nextAction='accept_and_prepare_contract';contractReady=true;}else if(counter>=protectedMao*0.95){decision='contract_ready';nextAction='accept_within_protected_mao_and_prepare_contract';contractReady=true;}else if(sellerMotivation>=75&&risk!=='high'){const floor=Math.max(currentOffer,protectedMao*0.90);revisedOffer=Math.min(counter-1>0?counter-1:counter,floor);revisedOffer=Math.max(revisedOffer,currentOffer||0);decision='revised_offer';nextAction='send_controlled_revised_offer';}else{decision='human_review';nextAction='review_negotiation_gap_before_reoffer';}}else{decision='human_review';nextAction='validate_protected_mao_before_decision';} const investorProfit=arv>0&&repairs>=0&&protectedMao>0?arv-repairs-counter:null; const idempotencyKey='wf438:'+input.leadId+':'+input.dealId+':'+input.counterofferId; return [{json:{...input,sellerCounterofferDecision:{status:flags.length?'review_required':'evaluated',decision,nextAction,counterofferAmount:counter,currentOfferAmount:currentOffer,protectedMao,negotiationGap:gap,negotiationGapPercent:gapPct,maoGap,maoUtilization,sellerMotivationScore:sellerMotivation,riskLevel:risk,revisedOfferAmount:revisedOffer,walkAway,contractReady,projectedInvestorProfit:investorProfit,flags,requiresHumanReview:decision==='human_review',confidenceScore:flags.length?25:(decision==='human_review'?60:94)},idempotencyKey}}];"
