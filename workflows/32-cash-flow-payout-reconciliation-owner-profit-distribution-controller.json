    {
      "parameters": {
        "jsCode": "const c = $json;\nconst deal = c.deal ?? c.data?.deal ?? {};\nconst settlement = c.settlement ?? c.data?.settlement ?? {};\nconst completion = c.completion ?? c.data?.completion ?? {};\nconst payout = c.payout ?? c.data?.payout ?? {};\nconst dealState = String(deal.state ?? deal.status ?? '').toLowerCase();\nconst settlementStatus = String(settlement.status ?? '').toLowerCase();\nconst completionStatus = String(completion.status ?? '').toLowerCase();\nconst issues = [];\nif (!['closed','closed_settled'].includes(dealState)) issues.push('deal_not_closed:' + dealState);\nif (!['settled','completed'].includes(settlementStatus)) issues.push('settlement_not_confirmed:' + settlementStatus);\nif (!['completed','closed'].includes(completionStatus)) issues.push('transaction_completion_not_confirmed:' + completionStatus);\nconst grossRevenue = Number(payout.grossRevenue ?? deal.grossRevenue ?? deal.assignmentFee ?? 0);\nconst closingCosts = Number(payout.closingCosts ?? deal.closingCosts ?? 0);\nconst otherCosts = Number(payout.otherCosts ?? deal.otherCosts ?? 0);\nconst netProfit = Number(payout.netProfit ?? deal.netProfit ?? (grossRevenue - closingCosts - otherCosts));\nconst ownerSharePercent = Number(payout.ownerSharePercent ?? c.ownerSharePercent ?? 100);\nconst reserveAmount = Number(payout.reserveAmount ?? c.reserveAmount ?? 0);\nconst ownerDistribution = Number(payout.ownerDistribution ?? (netProfit * ownerSharePercent / 100 - reserveAmount));\nconst reconciliationDelta = Number(payout.reconciliationDelta ?? 0);\nif (![grossRevenue, closingCosts, otherCosts, netProfit, ownerSharePercent, reserveAmount, ownerDistribution, reconciliationDelta].every(Number.isFinite)) issues.push('financial_values_not_numeric');\nif (grossRevenue < 0 || closingCosts < 0 || otherCosts < 0 || reserveAmount < 0) issues.push('negative_financial_input');\nif (ownerSharePercent < 0 || ownerSharePercent > 100) issues.push('owner_share_percent_out_of_range');\nif (ownerDistribution < 0) issues.push('owner_distribution_negative');\nif (Math.abs(reconciliationDelta) > 0.01) issues.push('reconciliation_delta_not_zero');\nconst eligible = issues.length === 0;\nreturn [{ json: { ...$json, deal, settlement, completion, payout, dealState, settlementStatus, completionStatus, grossRevenue, closingCosts, otherCosts, netProfit, ownerSharePercent, reserveAmount, ownerDistribution, reconciliationDelta, issues, payoutEligible: eligible } }];"
      },
