    {
      "parameters": {
        "jsCode": "const input=$('Normalize Buyer Disposition Event').first().json; const c=$json.context??$json; const n=x=>Number.isFinite(Number(x))?Number(x):0; const event=String(input.eventType).toLowerCase(); const dealStatus=String(c.dealStatus??'').toLowerCase(); const buyerStatus=String(c.buyerStatus??'active').toLowerCase(); const dnc=c.buyerDnc===true||c.buyerSuppressed===true||event==='buyer_dnc'; const protectedDeal=['closed','cancelled','disputed'].includes(dealStatus); const assignmentEligible=c.assignmentEligible===true; const contractExecuted=c.contractExecuted===true||String(c.contractStatus??'').toLowerCase()==='executed'; const purchasePrice=n(c.purchasePrice); const assignmentFee=n(c.assignmentFee); const arv=n(c.arv); const repairs=n(c.repairs); const buyerOffer=n(c.buyerOffer??input.buyerOffer); const buyerPofVerified=c.pofVerified===true; const buyerQualified=c.buyerQualified===true; const buyBoxMatch=c.buyBoxMatch===true; const activeLockBuyerId=String(c.activeLockBuyerId??''); const eventAlreadyProcessed=c.eventAlreadyProcessed===true; let decision='review'; let action='human_review'; const flags=[]; let matchScore=0; if(protectedDeal){decision='blocked';action='no_action';flags.push('protected_deal_state');} else if(dnc||['inactive','blocked','suppressed'].includes(buyerStatus)){decision='buyer_blocked';action='suppress_buyer_distribution';flags.push('buyer_blocked_or_suppressed');} else if(eventAlreadyProcessed){decision='duplicate';action='do_not_reprocess';flags.push('duplicate_event');} else if(event==='assignment_ready'||event==='package_ready'){ if(!assignmentEligible||!contractExecuted){decision='assignment_not_ready';action='hold_distribution';flags.push('assignment_or_contract_not_ready');} else {decision='match_and_distribute';action='build_buyer_package_and_match';}} else if(['interested','offer','lock_request','schedule_call'].includes(event)){ if(!buyerQualified&&!buyerPofVerified){decision='buyer_qualification_required';action='collect_buyer_qualification_and_pof';flags.push('buyer_qualification_missing');} else if(event==='offer'&&buyerOffer>0&&purchasePrice>0&&buyerOffer<purchasePrice){decision='buyer_offer_review';action='evaluate_buyer_offer';flags.push('buyer_offer_below_purchase_price');} else if(event==='lock_request'||event==='interested'){ if(activeLockBuyerId&&activeLockBuyerId!==input.buyerId){decision='lock_conflict';action='protect_existing_buyer_lock';flags.push('existing_exclusive_buyer_lock');} else {decision=event==='lock_request'?'lock_candidate':'buyer_interest';action=event==='lock_request'?'verify_exclusivity_and_lock':'record_buyer_interest';}} else {decision='buyer_follow_up';action='schedule_buyer_follow_up';}} else if(['declined','expired'].includes(event)){decision='buyer_declined';action='release_buyer_and_continue_distribution';} else if(event==='buyer_dnc'){decision='buyer_blocked';action='suppress_buyer_distribution';flags.push('buyer_dnc');} else {decision='human_review';action='review_buyer_event';flags.push('unknown_event');} matchScore=Math.round((buyBoxMatch?35:0)+(buyerQualified?20:0)+(buyerPofVerified?20:0)+(assignmentEligible?10:0)+(contractExecuted?10:0)+(arv>0?2:0)+(repairs>=0?1:0)+(purchasePrice>0?1:0)); if(matchScore>=80&&!flags.length)decision=event==='assignment_ready'||event==='package_ready'?'match_and_distribute':decision; const lockEligible=decision==='lock_candidate'&&buyerQualified&&buyerPofVerified&&assignmentEligible&&contractExecuted&&!activeLockBuyerId; const nextEvent=lockEligible?'buyer_exclusive_lock':decision==='match_and_distribute'?'buyer_distribution':'none'; return [{json:{...input,canonicalBuyerDisposition:{decision,action,matchScore,assignmentEligible,contractExecuted,buyerQualified,buyerPofVerified,buyBoxMatch,purchasePrice,assignmentFee,arv,repairs,buyerOffer,lockEligible,activeLockBuyerId,flags,nextEvent,requiresHumanReview:['buyer_offer_review','lock_conflict','human_review'].includes(decision),confidenceScore:Math.min(95,40+matchScore)},idempotencyKey}}];"
      },
