    {
      "parameters": {
        "jsCode": "const input=$('Normalize Lead Qualification Request').first().json; const ctx=$json.context??$json; const n=v=>Number.isFinite(Number(v))?Number(v):0; const score=(v,def=50)=>Math.max(0,Math.min(100,n(v)||def)); const distress=score(ctx.distressScore??ctx.propertyDistressScore,50); const equity=score(ctx.equityScore,50); const repairs=score(ctx.repairScore??ctx.repairBurdenScore,50); const motivation=score(ctx.motivationScore,50); const timeline=score(ctx.timelineScore,50); const occupancy=score(ctx.occupancyScore,50); const ownership=score(ctx.ownershipScore,50); const contactability=score(ctx.contactabilityScore,50); const sourceQuality=score(ctx.sourceQualityScore,50); const engagement=score(ctx.engagementScore,50); const weights={distress:.13,equity:.12,repairs:.09,motivation:.18,timeline:.12,occupancy:.06,ownership:.07,contactability:.09,sourceQuality:.06,engagement:.08}; const priority=Math.round(distress*weights.distress+equity*weights.equity+repairs*weights.repairs+motivation*weights.motivation+timeline*weights.timeline+occupancy*weights.occupancy+ownership*weights.ownership+contactability*weights.contactability+sourceQuality*weights.sourceQuality+engagement*weights.engagement); const dnc=ctx.dnc===true||ctx.suppressed===true; const invalid=ctx.invalidLead===true; let tier=priority>=80?'A':priority>=60?'B':priority>=40?'C':'D'; let status=invalid?'invalid':dnc?'blocked':priority>=70?'qualified':priority>=45?'needs_qualification':'nurture'; let nextAction=invalid||dnc?'do_not_contact':priority>=80?'priority_human_conversation':priority>=65?'continue_qualification':priority>=45?'collect_missing_information':'nurture_and_reengage'; const evidence=[]; if(distress>=70)evidence.push('strong_property_distress_signal'); if(equity>=70)evidence.push('strong_equity_signal'); if(motivation>=70)evidence.push('strong_seller_motivation_signal'); if(timeline>=70)evidence.push('urgent_timeline_signal'); if(contactability<40)evidence.push('weak_contactability'); if(ctx.message) evidence.push('seller_message_available'); const confidence=Math.max(35,Math.min(95,Math.round(55+evidence.length*6-(ctx.missingFields?.length??0)*4))); const idempotencyKey='wf456:'+input.leadId+':'+(input.propertyId||'none')+':'+(input.campaignId||'none'); return [{json:{...input,aiQualification:{status,tier,priorityScore:priority,componentScores:{distress,equity,repairs,motivation,timeline,occupancy,ownership,contactability,sourceQuality,engagement},recommendedNextAction:nextAction,evidence,confidenceScore:confidence,flags:[...(dnc?['dnc_or_suppressed']:[]),...(invalid?['invalid_lead']:[]),...(contactability<40?['low_contactability']:[])],requiresHumanReview:priority>=80&&!dnc&&!invalid},idempotencyKey}}];"
      },
